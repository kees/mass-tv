import "pkg:/source/lib/Store.bs"
import "pkg:/source/lib/Profiles.bs"
import "pkg:/source/lib/Jwt.bs"

' Screen y (the screen itself sits 96 px down, below where the nav bar
' would be) of the title's center, the list's center, and the button's
' center: a quarter of the way down, the middle, and three quarters.
const SCREEN_Y = 96
const TITLE_CENTER = 270
const LIST_CENTER = 540
const BUTTON_CENTER = 810
' Room kept between the list and the title or the button.
const LIST_MARGIN = 40
' The list's rows (MenuRow, 64 tall, 8 apart).
const ROW_STEP = 72
const ROW_GAP = 8

sub init()
    m.logTag = "profiles"
    m.list = m.top.findNode("list")
    m.title = m.top.findNode("title")
    m.linkButton = m.top.findNode("linkButton")
    m.linkButton.buttons = ["Link a new profile"]
    m.linkButton.ObserveField("selected", "onLink")
    placeFixed()
    m.top.findNode("listScroll").list = m.list
    m.list.ObserveField("itemSelected", "onSelected")
    speakLists([m.list], { list: "rows" })
    m.focusTarget = m.list
    m.top.ObserveField("params", "onParams")
end sub

' The title and the button stay put, whatever the number of profiles; the
' list gets as many rows as fit between them (around the middle, with
' LIST_MARGIN to each), then scrolls.
sub placeFixed()
    titleH = m.title.boundingRect().height
    m.title.translation = [0, TITLE_CENTER - SCREEN_Y - Int(titleH / 2)]
    b = m.linkButton.boundingRect()
    buttonTop = BUTTON_CENTER - Int(b.height / 2)
    m.linkButton.translation = [Int((1920 - b.width) / 2), buttonTop - SCREEN_Y]
    above = LIST_CENTER - (TITLE_CENTER + Int(titleH / 2) + LIST_MARGIN)
    below = (buttonTop - LIST_MARGIN) - LIST_CENTER
    half = above
    if below < half then half = below
    rows = Int((2 * half + ROW_GAP) / ROW_STEP)
    if rows < 1 then rows = 1
    m.list.numRows = rows
end sub

' Centers the list's shown rows on the middle of the screen.
sub layout()
    rows = m.profiles.Count()
    if rows > m.list.numRows then rows = m.list.numRows
    listH = rows * ROW_STEP - ROW_GAP
    m.list.translation = [m.list.translation[0], LIST_CENTER - SCREEN_Y - Int(listH / 2)]
end sub

' The list, on row index; -1 keeps the row it had (the list keeps its
' focused row while the button has the focus).
sub focusList(index as integer)
    if index >= 0 then m.list.jumpToItem = index
    m.focusTarget = m.list
    focustrack.set(m.list)
end sub

sub focusButton()
    m.focusTarget = m.linkButton
    focustrack.set(m.linkButton)
end sub

sub onLink()
    log.debug("profiles", "link a profile")
    m.top.navigate = { screen: "setup", params: {}, root: true }
end sub

sub onParams()
    m.profiles = store.profileList()
    root = CreateObject("roSGNode", "ContentNode")
    nowSec = CreateObject("roDateTime").AsSeconds()
    ' With profiles on more than one server, each row says which.
    many = profiles.manyServers(m.profiles)
    for each p in m.profiles
        n = root.CreateChild("ContentNode")
        label = profiles.displayName(p)
        if many then label = label + "  ·  " + profiles.serverLabel(p)
        days = jwt.daysLeft(p.token, nowSec)
        if days <> invalid and days < 0
            label = label + "  (link expired)"
        else if days <> invalid and days < 30
            label = label + "  (link expires soon)"
        end if
        n.title = label
    end for
    m.list.content = root
    m.list.visible = m.profiles.Count() > 0
    layout()
    idx = profiles.initialIndex(m.profiles, store.lastProfile())
    if idx >= 0 then focusList(idx) else focusButton()
end sub

' Down from the list's last row goes to the button, Up from its first to
' the button too (the list passes both on), and so do Left and Right from
' any row; from the button Down wraps to the first row, Up to the last,
' and Left and Right return to the row that had the focus.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.list.content = invalid then return false
    count = m.list.content.getChildCount()
    if m.list.hasFocus() and (key = "down" or key = "up" or key = "left" or key = "right")
        focusButton()
        return true
    else if m.linkButton.isInFocusChain() and count > 0
        if key = "down"
            focusList(0)
            return true
        else if key = "up"
            focusList(count - 1)
            return true
        else if key = "left" or key = "right"
            focusList(-1)
            return true
        end if
    end if
    return false
end function

sub onSelected()
    idx = m.list.itemSelected
    if idx >= m.profiles.Count() then return
    p = m.profiles[idx]
    days = jwt.daysLeft(p.token, CreateObject("roDateTime").AsSeconds())
    if days <> invalid and days < 0
        m.global.toast = "That link has expired. Link the profile again."
        m.top.navigate = { screen: "setup", params: { server: util.str(util.get(p, "server"), "") }, root: true }
        return
    end if
    log.info("profiles", "chosen", { user: p.username })
    m.top.profileChosen = p
end sub
