import "pkg:/source/lib/Store.bs"

const MAX_TRACKS_SHOWN = 500
' Cards per artist row (albums and the compilations an artist appears on
' can run to hundreds).
const ARTIST_ROW_MAX = 50

sub init()
    m.logTag = "detail"
    m.empty = m.top.findNode("empty")
    m.art = m.top.findNode("art")
    m.kind = m.top.findNode("kind")
    m.titleLabel = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
    m.info = m.top.findNode("info")
    m.about = m.top.findNode("about")
    m.buttons = m.top.findNode("buttons")
    m.tracks = m.top.findNode("tracks")
    m.rows = m.top.findNode("rows")
    m.tracksFade = m.top.findNode("tracksFade")
    m.tracksFade.list = m.tracks
    m.loadingIndicator = m.top.findNode("loadingIndicator")
    m.buttons.ObserveField("selected", "onButton")
    m.tracks.ObserveField("itemSelected", "onTrackSelected")
    m.tracks.ObserveField("itemFocused", "onTrackFocused")
    m.rows.ObserveField("rowItemSelected", "onRowSelected")
    m.rows.ObserveField("rowItemFocused", "onRowFocused")
    m.focusTarget = m.buttons
    speakLists([m.tracks, m.rows], { tracks: "tracks" })
    m.trackData = []
    m.listFromHere = false
    m.canSortByDate = false
    m.sortBy = ""
    m.top.ObserveField("params", "onParams")
    ' What the keys do where the focus is (shown at the bottom while
    ' nothing plays): the buttons, the tracks, or the rows of cards.
    onFocusMoves([m.buttons, m.tracks, m.rows], "updatePageHint")
    m.buttons.ObserveFieldScoped("focusIndex", "updatePageHint")
    m.global.ObserveFieldScoped("queueState", "onQueueState")
    ' The source names can arrive after the page opens (just after launch).
    m.global.ObserveFieldScoped("musicSources", "onMusicSources")
end sub

sub onMusicSources()
    if m.item <> invalid then layoutText()
end sub

sub onParams()
    ' The queue is polled only while something plays; ask for one poll so
    ' the Shuffle button can show MA's shuffle state.
    if util.getPath(m.global.queueState, "shuffle_enabled") = invalid then m.global.pollKick = true
    m.item = util.get(m.top.params, "item", {})
    m.type = ma.mediaTypeOf(m.item)
    m.isArtist = m.type = "artist"
    ' A track's page: rows of cards (its album, its artists) instead of a
    ' track list. Opened from an album's or playlist's list, it knows that
    ' list (context: what to play, from this track).
    m.isTrack = m.type = "track"
    m.context = util.get(m.top.params, "context")
    m.usesRows = m.isArtist or m.isTrack
    m.listFromHere = store.listFromPickedTrack()
    if m.isTrack then log.debug("detail", "track page", { uri: ma.uriOf(m.item), name: util.get(m.item, "name"), from: util.get(m.context, "media") })
    ' A playlist's "Newest first" choice is remembered per playlist.
    m.orderKey = ma.uriOf(m.item)
    if m.type = "playlist" then m.sortBy = util.str(util.get(playlistOrders(), m.orderKey), "")
    m.tracks.visible = not m.usesRows
    m.tracksFade.visible = not m.usesRows
    m.rows.visible = m.usesRows
    m.trackContent = CreateObject("roSGNode", "ContentNode")
    m.tracks.content = m.trackContent
    renderHeader()
    buildButtons()
    uri = ma.uriOf(m.item)
    ' A discography's album that isn't in the library is a MusicBrainz
    ' entry: MA finds it on one of the user's music services when it's
    ' opened, and the page loads that album's tracks.
    m.resolving = util.str(util.get(m.item, "provider"), "") = "musicbrainz"
    if uri <> "" then apic.call("music/item_by_uri", { uri: uri }, onFullItem, invalid, { timeoutMs: 30000 })
    ' Whether this item is in Home's "Recently played" (More then offers
    ' to remove it).
    m.recentList = invalid
    apic.call("music/recently_played_items", { limit: ma.RECENT_LIMIT }, onRecentList)
    if m.resolving
        m.loadingIndicator.active = true
    else
        loadChildren()
    end if
end sub

sub renderHeader()
    kinds = { album: "ALBUM", playlist: "PLAYLIST", artist: "ARTIST", podcast: "PODCAST", audiobook: "AUDIOBOOK", track: "TRACK" }
    m.kind.text = util.str(kinds[m.type], UCase(m.type))
    fonts.label(m.titleLabel, ma.titleOf(m.item), true)
    layoutText()
    m.art.uri = images.urlFor(server(), m.item, 512)
    if not m.tracks.isInFocusChain() and not m.rows.isInFocusChain() then setFocusedPlay(invalid)
end sub

' The header's text between the title and the buttons, with the item's
' description (MA's, from the full item) when it has one:
' - artist: the description on up to three lines (a subtitle would only
'   repeat the ARTIST label, so there is none);
' - album with a description: subtitle and info joined on one line
'   ("Artist · 2009 · 12 tracks · 47:09"), the description on two below;
' - otherwise: subtitle, then info (track count and length).
' An album's info ends with where it comes from, as MA names the source
' ("12 tracks · 47:09 · <source>", ma.sourceText).
sub layoutText()
    desc = ""
    if m.isArtist or m.type = "album" then desc = ma.descriptionOf(m.item)
    subtitle = ma.subtitleOf(m.item)
    info = util.str(m.infoText, "")
    ' A track: its length (the album and artists are in the subtitle).
    if m.isTrack and info = ""
        dur = util.get(m.item, "duration", 0)
        if util.isNumber(dur) and dur > 0 then info = util.formatDuration(dur)
    end if
    if m.type = "album" or m.isTrack
        source = ma.sourceText(m.item, m.global.musicSources)
        if source <> "" and info <> "" then info = info + " · " + source
        if source <> "" and info = "" then info = source
        log.debug("detail", "info", { text: info })
    end if
    fonts.label(m.about, desc)
    m.about.visible = desc <> ""
    if m.isArtist
        fonts.label(m.subtitle, "")
        fonts.label(m.info, "")
        m.about.translation = [480, 134]
        m.about.maxLines = 3
    else if desc <> ""
        line = subtitle
        if line <> "" and info <> "" then line = line + " · "
        fonts.label(m.subtitle, line + info)
        fonts.label(m.info, "")
        m.about.translation = [480, 178]
        m.about.maxLines = 2
    else
        fonts.label(m.subtitle, subtitle)
        fonts.label(m.info, info)
    end if
    ' Said before the focused button when the buttons get focus: "Goldberg
    ' Variations, album, Kimiko Ishizaka, 2012".
    subtitleSaid = subtitle
    if m.isArtist then subtitleSaid = ""
    m.buttons.context = speech.join([ma.titleOf(m.item), LCase(m.kind.text), subtitleSaid])
end sub

' What the Play key plays here: with a track focused in the list, that
' track (as MA's web UI plays a picked track; a track's page offers "Play
' album from here"); a podcast's episode, the podcast from that episode;
' otherwise the whole item.
sub setFocusedPlay(track as dynamic)
    ' The profile's "Queue collection when playing a track": the album or
    ' playlist starting with it.
    if util.isAA(track) and ma.mediaTypeOf(track) = "track" and not m.listFromHere
        m.top.focusedItem = track
        m.top.focusedPlay = {}
        return
    end if
    m.top.focusedItem = m.item
    ' Shuffle is passed explicitly: play_media only follows the queue's
    ' shuffle setting for playlists; an album switches it off.
    ctx = { media: ma.uriOf(m.item), sortBy: activeSort(), shuffle: m.shuffleOn = true }
    if util.isAA(track)
        ctx.startItem = ma.uriOf(track)
        ' For the Now Playing bar while MA starts it.
        ctx.shown = track
    end if
    m.top.focusedPlay = ctx
end sub

sub buildButtons()
    m.buttonIds = ["play"]
    labels = ["Play"]
    active = [false]
    ' Shuffle switches MA's queue shuffle and shows it; Play and picking a
    ' track pass it to play_media (which otherwise turns shuffle off for an
    ' album). A single track has nothing to shuffle.
    if m.shuffleOn = invalid then m.shuffleOn = queueShuffles()
    if m.isTrack
        ' A track's page: queue it without leaving the page.
        m.buttonIds.Push("add")
        labels.Push("Add to queue")
        active.Push(false)
    else
        m.buttonIds.Push("shuffle")
        labels.Push("Shuffle")
        active.Push(m.shuffleOn)
    end if
    if m.type <> "podcast" and m.type <> "audiobook"
        m.buttonIds.Push("radio")
        ' MA's endless mix (radio_playlist://): the item's tracks plus
        ' similar ones, without end; named as MA's web UI names it.
        labels.Push("Endless mix")
        active.Push(false)
    end if
    ' A switch like Shuffle: blue while the item is a favorite.
    m.buttonIds.Push("favorite")
    labels.Push("Favorite")
    active.Push(m.item.favorite = true)
    if m.canSortByDate
        m.buttonIds.Push("newest")
        labels.Push("Newest first")
        active.Push(m.sortBy = ma.SORT_NEWEST)
    end if
    ' "More": the item's options menu (the only way to reach it).
    m.buttonIds.Push("more")
    labels.Push("More")
    active.Push(false)
    m.buttons.buttons = labels
    m.buttons.active = active
    ' A switch's hint says what OK does now ("turn shuffle off").
    updatePageHint()
end sub

' Item options the page's buttons already offer, left out of its More
' menu (which then holds Play next, Add to queue, View artist; a track's
' page has Add to queue as a button).
function buttonActions() as object
    if m.isTrack then return ["play", "add", "radio", "favorite"]
    return ["play", "shuffle", "radio", "favorite"]
end function

function queueShuffles() as boolean
    return util.getPath(m.global.queueState, "shuffle_enabled") = true
end function

' The queue poll may change MA's shuffle state (e.g. from Now Playing or
' MA's web UI); update the Shuffle button.
sub onQueueState()
    if m.buttonIds = invalid or queueShuffles() = m.shuffleOn then return
    m.shuffleOn = queueShuffles()
    log.debug("detail", "queue shuffle", { on: m.shuffleOn })
    buildButtons()
end sub

' Flips MA's queue shuffle. Right after launch the queue may not have been
' polled yet; then ask MA for the real state first, or a press could ask
' for the state MA is already in (seen on the device).
sub toggleShuffle()
    if util.getPath(m.global.queueState, "shuffle_enabled") <> invalid
        setQueueShuffle(not m.shuffleOn)
        return
    end if
    qid = actions.playerQueueId()
    if qid = ""
        actions.toast("This TV isn't set up as a Music Assistant player yet.")
        return
    end if
    log.debug("detail", "shuffle state unknown; asking MA")
    apic.call("player_queues/get", { queue_id: qid }, onShuffleKnown)
end sub

sub onShuffleKnown(resp as object, ctx as dynamic)
    if not resp.ok or not util.isAA(resp.data)
        actions.toast("Couldn't change shuffle.")
        return
    end if
    setQueueShuffle(not (util.get(resp.data, "shuffle_enabled") = true))
end sub

' Shows the new state at once, and puts it back if MA refuses (it does
' while the queue is in its "dynamic" smart-mix mode).
sub setQueueShuffle(enabled as boolean)
    qid = actions.playerQueueId()
    if qid = ""
        actions.toast("This TV isn't set up as a Music Assistant player yet.")
        return
    end if
    log.info("detail", "set shuffle", { on: enabled })
    m.shuffleOn = enabled
    buildButtons()
    apic.call("player_queues/shuffle", { queue_id: qid, shuffle_enabled: enabled }, onShuffleSet, { on: enabled })
end sub

sub onShuffleSet(resp as object, ctx as object)
    m.global.pollKick = true
    if resp.ok then return
    log.warn("detail", "shuffle refused", { on: ctx.on, status: resp.status, error: resp.error })
    m.shuffleOn = not ctx.on
    buildButtons()
    actions.toast("Couldn't change shuffle.")
end sub

' The track order MA should play in: the list's order, when it isn't the
' playlist's own.
function activeSort() as string
    if m.canSortByDate then return m.sortBy
    return ""
end function

function playlistOrders() as object
    orders = util.get(store.settings(), "playlistOrder")
    if not util.isAA(orders) then orders = {}
    return orders
end function

sub toggleNewestFirst()
    if m.sortBy = ma.SORT_NEWEST then m.sortBy = "" else m.sortBy = ma.SORT_NEWEST
    orders = playlistOrders()
    if m.sortBy = "" then orders.Delete(m.orderKey) else orders[m.orderKey] = m.sortBy
    store.setSetting("playlistOrder", orders)
    log.debug("detail", "playlist order", { sortBy: m.sortBy })
    buildButtons()
    renderTracks()
    m.tracks.jumpToItem = 0
end sub

sub onFullItem(resp as object, ctx as dynamic)
    if not resp.ok or not util.isAA(resp.data)
        if m.resolving
            m.resolving = false
            m.loadingIndicator.active = false
            log.info("detail", "not on the user's services", { uri: ma.uriOf(m.item), error: resp.error })
            m.infoText = "Not available on any of your music services."
            layoutText()
        end if
        return
    end if
    m.item = resp.data
    renderHeader()
    buildButtons()
    ' The full track's album and artists (with their images), unless the
    ' rows are being browsed.
    if m.isTrack and not m.rows.isInFocusChain() then buildTrackRows()
    if m.resolving
        m.resolving = false
        log.debug("detail", "resolved", { uri: ma.uriOf(m.item) })
        loadChildren()
    end if
end sub

' A track page's rows, from the track itself: its album, then its
' artists, each row only when the track has one.
sub buildTrackRows()
    m.rowRoot = CreateObject("roSGNode", "ContentNode")
    album = util.get(m.item, "album")
    if util.isAA(album)
        album = util.copyAA(album)
        if util.str(album.media_type, "") = "" then album.media_type = "album"
        row = m.rowRoot.CreateChild("ContentNode")
        row.title = "Album"
        row.appendChild(itemNode(album))
    end if
    artists = util.get(m.item, "artists")
    if util.isArray(artists) and artists.Count() > 0
        row = m.rowRoot.CreateChild("ContentNode")
        row.title = "Artists"
        for each a in artists
            if util.isAA(a)
                a = util.copyAA(a)
                if util.str(a.media_type, "") = "" then a.media_type = "artist"
                row.appendChild(itemNode(a))
            end if
        end for
    end if
    m.rows.content = m.rowRoot
end sub

sub loadChildren()
    if m.isTrack
        buildTrackRows()
        return
    end if
    id = util.str(util.get(m.item, "item_id"), "")
    prov = util.str(util.get(m.item, "provider"), "library")
    args = { item_id: id, provider_instance_id_or_domain: prov }
    opts = { timeoutMs: 30000 }
    ' Artist pages: below the first row's heading.
    if m.isArtist then m.loadingIndicator.translation = [96, 470]
    m.loadingIndicator.active = m.type = "album" or m.type = "playlist" or m.type = "podcast" or m.isArtist
    if m.type = "album"
        apic.call("music/albums/album_tracks", args, onTracks, invalid, opts)
    else if m.type = "playlist"
        apic.call("music/playlists/playlist_tracks", args, onTracks, invalid, opts)
    else if m.type = "podcast"
        apic.call("music/podcasts/podcast_episodes", args, onTracks, invalid, opts)
    else if m.isArtist
        m.rowRoot = CreateObject("roSGNode", "ContentNode")
        m.rows.content = m.rowRoot
        m.artistPending = 3
        m.ownAlbums = invalid
        m.artistTracks = invalid
        ' Rows in this order, each shown only when it has something: the
        ' artist's albums, the albums it appears on (filled from its
        ' tracks, below), its discography (a library artist's; a service's
        ' artist's Albums row already is its whole catalog), its top
        ' tracks, similar artists.
        for each spec in [["albums", "Albums", "music/artists/artist_albums"], ["appears", "Appears on", ""], ["discography", "Discography", ""], ["top", "Top tracks", "music/artists/top_tracks"], ["similar", "Similar artists", "music/artists/similar_artists"]]
            row = m.rowRoot.CreateChild("ContentNode")
            row.title = spec[1]
            if spec[0] = "appears"
                m.appearsRow = row
            else if spec[0] = "discography"
                if prov = "library"
                    m.artistPending = m.artistPending + 1
                    apic.call("music/artists/discography", args, onDiscography, { row: row }, opts)
                end if
            else
                a = util.copyAA(args)
                if spec[0] = "similar" then a.limit = 25
                apic.call(spec[2], a, onArtistRow, { row: row, kind: spec[0] }, opts)
            end if
        end for
        ' A library artist's tracks, for the albums it appears on without
        ' being their album artist (compilations).
        if prov = "library"
            m.artistPending = m.artistPending + 1
            apic.call("music/artists/artist_tracks", args, onArtistRow, { row: invalid, kind: "tracks" }, opts)
        end if
    end if
end sub

sub onTracks(resp as object, ctx as dynamic)
    m.loadingIndicator.active = false
    if not resp.ok or not util.isArray(resp.data)
        m.infoText = "Couldn't load the tracks."
        layoutText()
        return
    end if
    m.trackData = resp.data
    hadSort = m.canSortByDate
    m.canSortByDate = m.type = "playlist" and ma.hasDateAdded(resp.data)
    if m.canSortByDate <> hadSort then buildButtons()
    renderTracks()
    total = 0
    count = resp.data.Count()
    for each t in resp.data
        d = util.get(t, "duration", 0)
        if util.isNumber(d) then total = total + d
    end for
    info = util.counted(count, "track")
    if total > 0 then info = info + " · " + util.formatDuration(total)
    if count > MAX_TRACKS_SHOWN then info = info + " · showing first " + MAX_TRACKS_SHOWN.ToStr()
    m.infoText = info
    layoutText()
    log.debug("detail", "tracks", { count: count, sortable: m.canSortByDate })
end sub

sub renderTracks()
    tracks = m.trackData
    if activeSort() = ma.SORT_NEWEST then tracks = ma.sortNewestFirst(tracks)
    m.trackContent = CreateObject("roSGNode", "ContentNode")
    i = 0
    for each t in tracks
        i = i + 1
        if i > MAX_TRACKS_SHOWN then exit for
        d = util.get(t, "duration", 0)
        n = itemNode(t, 80)
        n.ShortDescriptionLine1 = i.ToStr()
        n.ShortDescriptionLine2 = util.formatDuration(d)
        if m.type = "album"
            n.description = ma.artistNames(t)
            ' Every track would repeat the album's cover shown above.
            n.AddFields({ noArt: true })
        end if
        speech.describeRow(n, d)
        m.trackContent.appendChild(n)
    end for
    m.tracks.content = m.trackContent
    ' A new order (Newest first) under the cursor is said.
    speakList(m.tracks)
end sub

sub onArtistRow(resp as object, ctx as object)
    data = []
    if resp.ok and util.isArray(resp.data) then data = resp.data
    if ctx.kind = "tracks"
        m.artistTracks = data
    else
        for each it in data
            if ctx.row.getChildCount() < ARTIST_ROW_MAX then ctx.row.appendChild(itemNode(it))
        end for
        if ctx.kind = "albums" then m.ownAlbums = data
    end if
    ' Once both are in: the albums it appears on, without its own.
    if ctx.kind = "albums" or ctx.kind = "tracks" then addAppearsOn()
    ' Only the first row shows before scrolling: wait for that one.
    if m.rowRoot.getChild(0).getChildCount() > 0 then m.loadingIndicator.active = false
    ' Once every row has answered, drop the empty ones (their headings
    ' would otherwise show with nothing under them).
    m.artistPending = m.artistPending - 1
    if m.artistPending > 0 then return
    m.loadingIndicator.active = false
    for i = m.rowRoot.getChildCount() - 1 to 0 step -1
        if m.rowRoot.getChild(i).getChildCount() = 0 then m.rowRoot.removeChildIndex(i)
    end for
    log.debug("detail", "artist rows", { rows: m.rowRoot.getChildCount() })
    if m.rowRoot.getChildCount() = 0
        m.empty.text = "Music Assistant has no top tracks, albums, or similar artists for " + ma.titleOf(m.item) + "."
        m.empty.visible = true
    end if
end sub

' The Discography row: MA's discography of the artist (MusicBrainz's, with
' the library's own albums in place; MA 2.11 on). An older MA, or none
' found, falls back to the whole catalog of one of the user's own
' streaming services the artist is linked to (its albums there).
sub onDiscography(resp as object, ctx as object)
    if resp.ok and util.isArray(resp.data) and resp.data.Count() > 0
        onArtistRow(resp, { row: ctx.row, kind: "discography" })
        return
    end if
    src = ma.discographySource(m.item, m.global.musicSources)
    log.debug("detail", "discography", { fromMa: resp.ok, via: src })
    if src = invalid
        onArtistRow({ ok: false }, { row: ctx.row, kind: "discography" })
        return
    end if
    apic.call("music/artists/artist_albums", { item_id: src.item_id, provider_instance_id_or_domain: src.provider_instance }, onArtistRow, { row: ctx.row, kind: "discography" }, { timeoutMs: 30000 })
end sub

' The albums a library artist appears on without being their album artist
' (from its tracks; MA lists only the others as its albums): the Appears
' on row, as MA's web UI has it.
sub addAppearsOn()
    if m.ownAlbums = invalid or m.artistTracks = invalid then return
    extra = ma.appearsOnAlbums(m.artistTracks, m.ownAlbums)
    log.debug("detail", "appears on", { own: m.ownAlbums.Count(), more: extra.Count() })
    for each a in extra
        if m.appearsRow.getChildCount() < ARTIST_ROW_MAX then m.appearsRow.appendChild(itemNode(a))
    end for
    m.artistTracks = invalid
end sub

sub onRecentList(resp as object, ctx as dynamic)
    if resp.ok and util.isArray(resp.data) then m.recentList = resp.data
end sub

' The key hint for where the focus is: on album and playlist pages only
' (their buttons and track list); none on the others, or with the focus
' elsewhere (the nav bar, a menu).
sub updatePageHint()
    hint = ""
    if (m.type = "album" or m.type = "playlist") and m.top.isInFocusChain()
        if m.tracks.isInFocusChain()
            hint = hints.listTrack(m.listFromHere = true, m.type)
        else if m.buttons.isInFocusChain()
            hint = hints.buttons(buttonOkText())
        end if
    end if
    if m.top.keyHint <> hint then m.top.keyHint = hint
end sub

' What OK does on the focused button, for the key hint.
function buttonOkText() as string
    if m.buttonIds = invalid then return ""
    id = util.str(m.buttonIds[m.buttons.focusIndex], "")
    kind = m.type
    if id = "play" then return "play the " + kind
    if id = "shuffle"
        if m.shuffleOn = true then return "turn shuffle off"
        return "turn shuffle on"
    end if
    if id = "radio" then return "start an endless mix from the " + kind
    if id = "favorite"
        if m.item.favorite = true then return "remove the " + kind + " from favorites"
        return "add the " + kind + " to favorites"
    end if
    if id = "newest"
        if m.sortBy = ma.SORT_NEWEST then return "list tracks in the playlist's order"
        return "list the newest tracks first"
    end if
    if id = "more" then return "see more options"
    return ""
end function

' A track page's Play: always the track itself, played now (MA's
' "play": what was queued after the current item still follows); its
' collections are in More ("Play album from here", "Play playlist from
' here").
sub playTrack()
    actions.play(m.item, "play")
end sub

sub onButton()
    id = m.buttonIds[m.buttons.selected]
    log.debug("detail", "button " + id)
    if id = "play" and m.isTrack
        playTrack()
    else if id = "play"
        actions.play(m.item, "replace", "", m.shuffleOn = true, activeSort())
    else if id = "add"
        actions.play(m.item, "add")
    else if id = "newest"
        toggleNewestFirst()
    else if id = "more"
        ' A track page opened from a playlist: "Play playlist from here"
        ' (its album one comes from the track itself).
        fromList = invalid
        if m.isTrack and util.str(util.get(m.context, "kind"), "") = "playlist" then fromList = m.context
        showItemOptions(m.item, buttonActions(), ma.recentEntryFor(m.recentList, m.item), fromList)
    else if id = "shuffle"
        toggleShuffle()
    else if id = "radio"
        actions.startRadio(m.item)
    else if id = "favorite"
        makeFav = not (m.item.favorite = true)
        actions.favorite(m.item, makeFav)
        m.item.favorite = makeFav
        buildButtons()
    end if
end sub

function trackAt(idx as integer) as dynamic
    n = m.trackContent.getChild(idx)
    if n = invalid then return invalid
    return n.item
end function

sub onTrackFocused()
    ' itemFocused also fires when content loads, before the list has focus.
    if not m.tracks.isInFocusChain() then return
    t = trackAt(m.tracks.itemFocused)
    setFocusedPlay(t)
end sub

' OK opens the track's page, which plays this list from the track (in
' the order shown); the Play key plays it from here at once.
sub onTrackSelected()
    t = trackAt(m.tracks.itemSelected)
    if t = invalid then return
    if ma.mediaTypeOf(t) <> "track"
        ' A podcast's episodes: no page of their own.
        actions.play(m.item, "replace", ma.uriOf(t), m.shuffleOn = true, activeSort(), t)
        return
    end if
    go("detail", { item: t, context: { media: ma.uriOf(m.item), kind: m.type, sortBy: activeSort(), shuffle: m.shuffleOn = true } })
end sub

function rowItemAt(rc as dynamic) as dynamic
    if not util.isArray(rc) or m.rowRoot = invalid then return invalid
    row = m.rowRoot.getChild(rc[0])
    if row = invalid then return invalid
    n = row.getChild(rc[1])
    if n = invalid then return invalid
    return n.item
end function

sub onRowFocused()
    if not m.rows.isInFocusChain() then return
    ' Artist rows hold whole albums/artists: Play plays the focused one.
    m.top.focusedItem = rowItemAt(m.rows.rowItemFocused)
    m.top.focusedPlay = {}
end sub

sub onRowSelected()
    openItem(rowItemAt(m.rows.rowItemSelected))
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    content = m.tracks
    if m.usesRows then content = m.rows
    if key = "down" and m.buttons.isInFocusChain()
        ' Nothing to land on (a track's page with no album or artists to
        ' show, an album with no tracks): the focus stays on the buttons.
        if content.content = invalid or content.content.getChildCount() = 0 then return true
        m.focusTarget = content
        ' Onto the card below the button (the track list keeps its track).
        aim.moveFocus(m.buttons, content)
        if m.usesRows
            onRowFocused()
        else
            onTrackFocused()
        end if
        return true
    else if key = "up" and content.isInFocusChain()
        m.focusTarget = m.buttons
        ' Onto the button above the card (from the track list, the button
        ' last used).
        aim.moveFocus(content, m.buttons)
        setFocusedPlay(invalid)
        return true
    else if ((key = "left" or key = "right") and not m.usesRows and content.isInFocusChain()) or (key = "back" and content.isInFocusChain())
        ' The track list has no use for Left/Right: jump to the buttons.
        ' Back from the tracks or an artist's rows goes up a level, to the
        ' buttons too (Back there leaves the page). The list keeps its
        ' focused item, so Down comes back to it.
        m.focusTarget = m.buttons
        focustrack.set(m.buttons)
        setFocusedPlay(invalid)
        return true
    end if
    return false
end function
