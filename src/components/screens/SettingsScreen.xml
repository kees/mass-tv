<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: tabs (Profile, This TV) over the shown tab's rows (a
     MarkupList of MenuRow; Up from its first row goes to the tabs, Up
     from the tabs to the nav bar). The right column shows the focused
     row's description at the top, the logo centered in the content area
     (between the nav bar and the Now Playing bar), and the About text
     under the logo. -->
<component name="SettingsScreen" extends="BaseScreen">
    <children>
        <TabRow id="tabs" translation="[96,24]" />
        <!-- Rows 780 wide: the longest label, "Help and support:
             github.com/kees/mass-tv", measures 724 at 1080p, plus the
             row's 24 padding on each side. Eight rows fit above the Now
             Playing bar; a tab has at most six. -->
        <MarkupList
            id="rows"
            translation="[96,100]"
            itemComponentName="MenuRow"
            itemSize="[780,64]"
            itemSpacing="[0,8]"
            numRows="8"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="floatingFocus" />

        <!-- Right column: x 930 to 1824 (894 wide), 54 right of the rows. -->
        <!-- Four lines fit above the logo's drawing (it starts at y 304);
             keep descriptions that short (about 220 characters). -->
        <Label id="detail" translation="[930,100]" width="894" wrap="true" maxLines="4" color="#9A9FB0" font="font:SmallSystemFont" />
        <!-- The logo (its drawing only: the image is trimmed, so it
             covers nothing beside it) at 200x246, centered at (1377,
             440), the middle of the column and of the content area (0 to
             880, above the Now Playing bar); small enough to leave room
             for the six lines below it. The image is made at that size
             per UI resolution ($$RES$$, the manifest's
             uri_resolution_autosub), since Roku shrinks images without
             smoothing. -->
        <Poster id="logo" uri="pkg:/images/logo_settings_$$RES$$.png" translation="[1277,317]" width="200" height="246" />
        <!-- Two lines (version, tagline), then after a gap four about this
             Roku (name, hardware, OS, screen and network); they end above
             the Now Playing bar (880). -->
        <Label id="about" translation="[930,574]" width="894" horizAlign="center" wrap="true" color="#9A9FB0" font="font:SmallSystemFont" />
        <Label id="device" translation="[930,680]" width="894" horizAlign="center" wrap="true" color="#9A9FB0" font="font:SmallSystemFont" />
    </children>
</component>
