import "pkg:/source/lib/Store.bs"

sub init()
    m.logTag = "nowplaying"
    m.idleSeconds = 0
    for each id in ["bgArt", "chrome", "art", "status", "modes", "title", "artist", "album", "barFill", "elapsed", "remaining", "quality", "transport", "actions", "upNext", "hint", "ambient", "ambientArt", "ambientText", "drift", "idleTimer"]
        m[id] = m.top.findNode(id)
    end for
    m.barWidth = m.top.findNode("barTrack").width
    ' Set by render: signed out, only the Play/Pause button shows.
    m.transportIds = []
    m.actionIds = []
    m.signedInShown = invalid
    m.transport.ObserveField("selected", "onTransport")
    m.actions.ObserveField("selected", "onAction")
    m.transport.ObserveField("focusIndex", "resetIdle")
    m.actions.ObserveField("focusIndex", "resetIdle")
    m.idleTimer.ObserveField("fire", "enterAmbient")
    m.global.ObserveFieldScoped("nowPlaying", "render")
    m.global.ObserveFieldScoped("queueState", "render")
    m.focusTarget = m.transport
    m.ambientOn = false
    ' Whether a track (by uri) is this profile's favorite: asked of MA when
    ' it starts playing, and set at once by the Favorite button. MA's queue
    ' items keep the flag they were queued with, so they're only the
    ' fallback until MA answers.
    m.favoriteFor = {}
    m.favoriteAsked = ""
    ' Not "", so the first render also sets up a missing cover.
    m.lastArt = "(none yet)"
    m.top.ObserveField("params", "onParams")
    ' Back from a screen on top (Lyrics): the idle time starts over.
    m.top.ObserveField("visible", "onVisible")
end sub

sub onParams()
    render()
    for i = 0 to m.transportIds.Count() - 1
        if m.transportIds[i] = "toggle" then m.transport.focusIndex = i
    end for
    loadIdleTime()
    resetIdle()
end sub

sub onVisible()
    if not m.top.visible then return
    ' The screensaver setting may have changed in Settings meanwhile.
    loadIdleTime()
    resetIdle()
end sub

' How long without a key press before the screensaver (0: never), from
' the settings.
sub loadIdleTime()
    m.idleSeconds = store.screensaverMinutes() * 60
    if m.idleSeconds > 0 then m.idleTimer.duration = m.idleSeconds
end sub

' Signed out (music MA started before anyone signed in), Mass TV is only a
' player: everything but pause and resume needs Music Assistant's API.
function signedIn() as boolean
    return util.str(util.get(m.global.session, "token"), "") <> ""
end function

sub render()
    np = m.global.nowPlaying
    q = m.global.queueState
    status = util.str(util.get(np, "status"), "idle")
    title = util.str(util.get(np, "title"), "")
    artist = util.str(util.get(np, "artist"), "")
    album = util.str(util.get(np, "album"), "")
    art = util.str(util.get(np, "art"), "")

    ' Prefer the server's queue item for what we're playing: it has
    ' complete metadata, formatted like the track rows (the stream's
    ' metadata drops the version and uses MA's own artist string).
    cur = ma.queueItemById(q, util.str(util.get(np, "queueItemId"), ""))
    if util.isAA(cur)
        mi = cur.media_item
        if util.isAA(mi)
            if ma.titleOf(mi) <> "" then title = ma.titleOf(mi)
            if ma.artistNames(mi) <> "" then artist = ma.artistNames(mi)
            if album = "" then album = util.str(util.getPath(mi, "album.name"), "")
        end if
        if art = "" then art = images.proxyUrl(server(), cur.image, 1024)
    end if

    statusText = ""
    ' The artist line may wrap only for the unlinked hint, which has no
    ' album line below it to run into.
    hintWraps = false
    if status = "paused"
        statusText = "PAUSED"
    else if status = "loading"
        statusText = "LOADING"
    else if status = "error"
        statusText = "CAN'T PLAY THIS TRACK"
    else if status = "idle" and util.get(np, "ended") = true
        ' The queue ran out: its last track stays shown, and Play, Prev,
        ' and Next work from it (actions.startQueue, actions.stepEnded).
        statusText = "QUEUE ENDED"
    else if status = "idle" or status = "stopped"
        statusText = "NOTHING PLAYING"
        if title = ""
            if signedIn()
                title = "Pick something from Home, Library, or Search"
            else
                title = "Play something from Music Assistant"
                ' Music Assistant names the player after the Roku, so this
                ' is the name to look for there.
                tv = util.str(util.getPath(m.global, "device.name"), "")
                if tv <> "" and artist = "" then artist = "Add this TV (" + tv + ") as a Player in Music Assistant"
                hintWraps = true
            end if
        end if
    end if
    m.status.text = statusText
    fonts.label(m.title, title, true)
    if m.artist.wrap <> hintWraps
        m.artist.wrap = hintWraps
        if hintWraps then m.artist.maxLines = 2 else m.artist.maxLines = 1
    end if
    fonts.label(m.artist, artist)
    fonts.label(m.album, album)
    if art <> m.lastArt
        m.lastArt = art
        ' All three (cover, ambient cover, blurred backdrop) show the
        ' placeholder for a missing or failed cover (CoverArt).
        m.art.uri = art
        m.ambientArt.uri = art
        m.bgArt.uri = art
    end if
    fonts.label(m.ambientText, title + "  ·  " + artist)

    shown = util.get(np, "position", 0)
    if m.top.seekPreview >= 0 then shown = m.top.seekPreview
    dur = util.get(np, "duration")
    if np <> invalid and np.isLive = true
        m.elapsed.text = util.formatDuration(shown)
        m.remaining.text = "LIVE"
        m.barFill.width = m.barWidth
    else if util.isNumber(dur) and dur > 0
        frac = shown / dur
        if frac > 1 then frac = 1
        if frac < 0 then frac = 0
        m.barFill.width = Int(m.barWidth * frac)
        m.elapsed.text = util.formatDuration(shown)
        m.remaining.text = "-" + util.formatDuration(dur - shown)
    else
        m.barFill.width = 0
        m.elapsed.text = util.formatDuration(shown)
        m.remaining.text = ""
    end if
    ' The source's format from MA's stream details for the item playing,
    ' and the format the Roku receives when it differs.
    quality = ""
    if util.isAA(cur) and np <> invalid and util.str(np.status, "") <> "stopped" then quality = ma.streamQualityText(util.get(cur, "audio_format"), util.str(util.get(np, "format"), ""))
    if m.quality.text <> quality
        m.quality.text = quality
        log.debug("nowplaying", "quality", { text: quality })
    end if

    ' The track MA enqueued on the player is authoritative and immediate; the
    ' polled queue lags a track change by up to one poll, so it's only used
    ' when it describes the item that's actually playing.
    upNext = ""
    nextTitle = util.str(util.get(np, "nextTitle"), "")
    if nextTitle <> ""
        upNext = nextTitle
        nextArtist = util.str(util.get(np, "nextArtist"), "")
        if nextArtist <> "" then upNext = upNext + " · " + nextArtist
    else if util.isAA(cur) and util.str(util.getPath(q, "current_item.queue_item_id"), "") = util.str(cur.queue_item_id, "")
        nxt = util.get(q, "next_item")
        if util.isAA(nxt) then upNext = util.str(nxt.name, "")
    end if
    if upNext <> ""
        fonts.label(m.upNext, "Up next: " + upNext)
    else
        m.upNext.text = ""
    end if

    playLabel = "Pause"
    if status <> "playing" and status <> "loading" then playLabel = "Play"
    ' Roku's system font lacks symbols like check marks and triangles, so
    ' toggle state is shown with words and blue text ("selected").
    shuffleOn = util.get(q, "shuffle_enabled", false) = true
    rep = util.str(util.get(q, "repeat_mode"), "off")
    repeatLabel = "Repeat"
    if rep = "all" then repeatLabel = "Repeat all"
    if rep = "one" then repeatLabel = "Repeat one"
    ' A mode MA adds later shows as MA names it, not as a plain "Repeat".
    if rep <> "off" and rep <> "all" and rep <> "one" then repeatLabel = "Repeat " + rep
    playingItem = util.get(playingQueueItem(), "media_item")
    liked = false
    if util.isAA(playingItem)
        askFavorite(playingItem)
        liked = isFavorite(playingItem)
    end if
    ' Size hints keep each button in place when its label changes.
    isIn = signedIn()
    if isIn
        ' "Favorite", blue when on: the same switch as on Detail pages.
        m.transportIds = ["previous", "toggle", "next", "shuffle", "repeat", "favorite"]
        transportLabels = ["Prev", playLabel, "Next", "Shuffle", repeatLabel, "Favorite"]
        transportHints = [[], ["Play", "Pause"], [], [], ["Repeat", "Repeat all", "Repeat one"], []]
        transportActive = [false, false, false, shuffleOn, rep <> "off", liked]
        m.actionIds = ["queue", "lyrics", "more"]
        actionLabels = ["Queue", "Lyrics", "More"]
        actionHints = [[], [], []]
        actionActive = [false, false, false]
        ' Lyrics and More act on the playing track: greyed until something
        ' is loaded (MA's queue keeps its last item after a stop), but kept
        ' for the track that ended the queue.
        loaded = status = "playing" or status = "paused" or status = "loading" or util.get(np, "ended") = true
        actionDisabled = [false, not loaded, not loaded]
        m.hint.text = hints.nowPlaying(status = "idle" and util.get(np, "ended") = true)
    else
        ' Signed out, Mass TV is only a player: just Play/Pause.
        m.transportIds = ["toggle"]
        transportLabels = [playLabel]
        transportHints = [["Play", "Pause"]]
        transportActive = [false]
        m.actionIds = []
        actionLabels = []
        actionHints = []
        actionActive = []
        actionDisabled = []
        m.hint.text = hints.nowPlayingSignedOut()
    end if
    ' Only when signing in or out changes the buttons: new hints rebuild
    ' the rows.
    if m.signedInShown <> isIn
        m.signedInShown = isIn
        m.transport.sizeHints = transportHints
        m.actions.sizeHints = actionHints
        m.actions.visible = isIn
        if not isIn and m.actions.isInFocusChain() then focusRow(m.transport)
    end if
    if not sameLabels(m.transport, transportLabels) then m.transport.buttons = transportLabels
    if not sameLabels(m.actions, actionLabels) then m.actions.buttons = actionLabels
    m.transport.active = transportActive
    m.actions.active = actionActive
    m.actions.disabled = actionDisabled

    modes = []
    if shuffleOn then modes.Push("SHUFFLE")
    if rep <> "off" then modes.Push("REPEAT " + UCase(rep))
    m.modes.text = modes.Join("  ·  ")

    ' The screen reader: the track goes before the focused button when the
    ' buttons get focus, and a new track is announced while they have it
    ' (e.g. after Next).
    statusSaid = "now playing"
    if statusText <> "" then statusSaid = LCase(statusText)
    said = speech.join([title, artist, album])
    ' Said when the transport row gets focus (the screen opening); the
    ' second row goes without, since it's reached from the first.
    m.transport.context = speech.join([statusSaid, said])
    buttonsFocused = m.transport.hasFocus() or m.actions.hasFocus()
    if m.saidTrack <> invalid and said <> m.saidTrack and buttonsFocused and (status = "playing" or status = "loading")
        speech.say(speech.join(["now playing", said]), false)
    end if
    m.saidTrack = said
end sub

function sameLabels(row as object, labels as object) as boolean
    old = row.buttons
    if old = invalid or old.Count() <> labels.Count() then return false
    for i = 0 to labels.Count() - 1
        if old[i] <> labels[i] then return false
    end for
    return true
end function

sub focusRow(row as object)
    m.focusTarget = row
    focustrack.set(row)
end sub

sub onTransport()
    runButton(m.transportIds[m.transport.selected])
end sub

sub onAction()
    runButton(m.actionIds[m.actions.selected])
end sub

sub runButton(id as string)
    q = m.global.queueState
    log.debug("nowplaying", "button " + id)
    if id = "previous"
        if not actions.stepEnded(-1) then actions.queueCommand("player_queues/previous")
    else if id = "toggle"
        status = util.str(util.get(m.global.nowPlaying, "status"), "idle")
        if status = "playing" or status = "paused" or status = "loading"
            m.global.player.command = "toggle"
        else
            actions.startQueue()
        end if
    else if id = "next"
        if not actions.stepEnded(1) then actions.queueCommand("player_queues/next")
    else if id = "shuffle"
        actions.queueCommand("player_queues/shuffle", { shuffle_enabled: not (util.get(q, "shuffle_enabled", false) = true) })
    else if id = "repeat"
        modes = { off: "all", all: "one", one: "off" }
        nextMode = modes[util.str(util.get(q, "repeat_mode"), "off")]
        if nextMode = invalid then nextMode = "all"
        actions.queueCommand("player_queues/repeat", { repeat_mode: nextMode })
    else if id = "favorite"
        mi = util.get(playingQueueItem(), "media_item")
        if util.isAA(mi)
            ' The switch shows the new state at once, as on Detail pages.
            makeFav = not isFavorite(mi)
            actions.favorite(mi, makeFav)
            m.favoriteFor[ma.uriOf(mi)] = makeFav
            render()
        end if
    else if id = "queue"
        ' On top of Now Playing, like Lyrics: Back comes back here.
        go("queue", {})
    else if id = "lyrics"
        go("lyrics", {})
    else if id = "more"
        ' The playing track's options, minus what this screen's buttons do
        ' or what makes no sense for the playing track. "Play album from
        ' here" replaces the queue with its album from this track, which
        ' starts the track over.
        mi = util.get(playingQueueItem(), "media_item")
        if util.isAA(mi)
            showItemOptions(mi, ["play", "next", "add", "favorite"])
        else
            ' Music Assistant's queue doesn't list the track yet: say so,
            ' and ask it again.
            log.info("nowplaying", "more: playing item not in the queue", { queueItemId: util.get(m.global.nowPlaying, "queueItemId") })
            actions.toast("Music Assistant hasn't listed this track yet. Try again in a moment.")
            m.global.pollKick = true
        end if
    end if
end sub

' The polled queue's item for what's playing (ma.queueItemById). With no
' queue item id (a stream not from MA's queue), the queue's current item.
function playingQueueItem() as dynamic
    q = m.global.queueState
    id = util.str(util.get(m.global.nowPlaying, "queueItemId"), "")
    if id = "" then return util.get(q, "current_item")
    return ma.queueItemById(q, id)
end function

' Whether the playing track is this profile's favorite: what MA said, or
' the Favorite button set, else the queue item's own flag.
function isFavorite(item as object) as boolean
    uri = ma.uriOf(item)
    if m.favoriteFor.DoesExist(uri) then return m.favoriteFor[uri] = true
    return item.favorite = true
end function

' Asks MA once per track whether it's this profile's favorite (its library
' item says so; MA's queue items keep the flag they were queued with).
sub askFavorite(item as object)
    uri = ma.uriOf(item)
    if uri = "" or uri = m.favoriteAsked or m.favoriteFor.DoesExist(uri) then return
    m.favoriteAsked = uri
    args = { media_type: ma.mediaTypeOf(item), item_id: util.str(item.item_id, ""), provider_instance_id_or_domain: util.str(item.provider, "library") }
    apic.call("music/get_library_item", args, onFavoriteState, { uri: uri })
end sub

sub onFavoriteState(resp as object, ctx as object)
    ' Not in the library (or MA failed): the queue item's flag stands.
    if not resp.ok or not util.isAA(resp.data) then return
    ' A press while MA answered wins: it's newer.
    if m.favoriteFor.DoesExist(ctx.uri) then return
    m.favoriteFor[ctx.uri] = resp.data.favorite = true
    log.debug("nowplaying", "favorite state", { uri: ctx.uri, favorite: m.favoriteFor[ctx.uri] })
    render()
end sub

sub enterAmbient()
    if m.ambientOn then return
    ' Not over an open menu or panel, or under another screen (Lyrics):
    ' wait for the next idle time.
    if m.choiceMenu <> invalid or not m.top.visible
        m.idleTimer.control = "start"
        return
    end if
    status = util.str(util.get(m.global.nowPlaying, "status"), "idle")
    if status <> "playing" and status <> "paused"
        m.idleTimer.control = "start"
        return
    end if
    log.debug("nowplaying", "ambient on")
    m.ambientOn = true
    m.chrome.visible = false
    m.ambient.visible = true
    m.bgArt.opacity = 0.1
    m.drift.control = "start"
    m.top.ambient = true
    ' Move focus off the buttons so every key (including OK and arrows,
    ' which they would consume) bubbles to onKeyEvent to wake up. Focusing
    ' m.top wouldn't work: it's already in the focus chain as their parent,
    ' so focus would stay on the buttons.
    focustrack.set(m.ambient)
end sub

sub exitAmbient()
    if not m.ambientOn then return
    log.debug("nowplaying", "ambient off")
    m.ambientOn = false
    m.drift.control = "stop"
    m.ambient.visible = false
    m.chrome.visible = true
    m.bgArt.opacity = 0.08
    m.top.ambient = false
    focustrack.set(m.focusTarget)
end sub

sub resetIdle()
    m.idleTimer.control = "stop"
    if m.idleSeconds > 0 then m.idleTimer.control = "start"
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    resetIdle()
    if m.ambientOn
        exitAmbient()
        ' Swallow the wake-up press unless it is a transport key.
        return not (key = "play" or key = "rewind" or key = "fastforward" or key = "replay")
    end if
    ' Between the two rows of buttons, aimed at the nearest button; Up
    ' from the first row goes on to the nav bar (MainScene).
    if key = "down" and m.transport.isInFocusChain() and m.actions.visible
        aim.moveFocus(m.transport, m.actions)
        m.focusTarget = m.actions
        return true
    else if key = "up" and m.actions.isInFocusChain()
        aim.moveFocus(m.actions, m.transport)
        m.focusTarget = m.transport
        return true
    end if
    return false
end function
