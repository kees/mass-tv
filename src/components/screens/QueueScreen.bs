' Shows a window of the queue around the current item (never the whole
' queue: MA's default page is 500 items, about 1.5 MB).
const WINDOW_BEFORE = 5
const WINDOW_SIZE = 50

sub init()
    m.logTag = "queue"
    m.list = m.top.findNode("list")
    m.top.findNode("listFade").list = m.list
    m.count = m.top.findNode("count")
    m.empty = m.top.findNode("empty")
    m.loadingIndicator = m.top.findNode("loadingIndicator")
    m.list.ObserveField("itemSelected", "onSelected")
    m.list.ObserveField("itemFocused", "onFocused")
    speakLists([m.list])
    m.global.ObserveFieldScoped("queueState", "onQueueState")
    ' The Roku starting another track moves "NOW" before the queue poll.
    m.lastPlayingId = util.str(util.get(m.global.nowPlaying, "queueItemId"), "")
    m.global.ObserveFieldScoped("nowPlaying", "onNowPlaying")
    m.focusTarget = m.list
    m.lastKey = ""
    m.top.ObserveField("params", "onParams")
end sub

sub onParams()
    refresh()
end sub

' Refetch when the current item or the item count changes.
sub onQueueState()
    q = m.global.queueState
    key = util.str(util.getPath(q, "current_item.queue_item_id"), "") + "|" + util.str(util.get(q, "items"), "")
    if key <> m.lastKey then refresh()
end sub

sub onNowPlaying()
    id = util.str(util.get(m.global.nowPlaying, "queueItemId"), "")
    if id = m.lastPlayingId then return
    m.lastPlayingId = id
    if m.list.content <> invalid then refresh()
end sub

sub refresh()
    q = m.global.queueState
    m.lastKey = util.str(util.getPath(q, "current_item.queue_item_id"), "") + "|" + util.str(util.get(q, "items"), "")
    qid = actions.playerQueueId()
    if qid = "" then return
    cur = util.toInt(util.get(q, "current_index"), 0)
    if cur = invalid then cur = 0
    m.windowStart = cur - WINDOW_BEFORE
    if m.windowStart < 0 then m.windowStart = 0
    m.currentIndex = cur
    ' Refreshes redraw a list already shown; only the first load is blank.
    if m.list.content = invalid then m.loadingIndicator.active = true
    apic.call("player_queues/items", { queue_id: qid, limit: WINDOW_SIZE, offset: m.windowStart }, onItems)
end sub

sub onItems(resp as object, ctx as dynamic)
    m.loadingIndicator.active = false
    if not resp.ok or not util.isArray(resp.data)
        m.empty.visible = true
        return
    end if
    root = CreateObject("roSGNode", "ContentNode")
    i = m.windowStart
    focusIdx = 0
    ' "NOW" marks the track the Roku is playing. MA's current index is
    ' only the fallback: its queue can be a track ahead (its Roku provider
    ' can take a new stream's start for a track change).
    playingId = util.str(util.get(m.global.nowPlaying, "queueItemId"), "")
    nowIndex = m.currentIndex
    if playingId <> ""
        j = m.windowStart
        for each qi in resp.data
            if util.str(util.get(qi, "queue_item_id"), "") = playingId then nowIndex = j
            j = j + 1
        end for
    end if
    if nowIndex <> m.currentIndex then log.info("queue", "the playing track isn't MA's current one", { playing: nowIndex, maCurrent: m.currentIndex })
    for each qi in resp.data
        mi = util.get(qi, "media_item")
        n = CreateObject("roSGNode", "ContentNode")
        ' Titled like every other track row (the queue item's own name is
        ' "Artist - Title", which repeats the artist line below it).
        n.title = util.str(util.get(qi, "name"), "")
        if util.isAA(mi)
            if ma.titleOf(mi) <> "" then n.title = ma.titleOf(mi)
            n.description = ma.subtitleOf(mi)
        end if
        ' The track's album art, else the queue item's own image.
        art = images.urlFor(server(), mi, 80)
        if art = "" then art = images.proxyUrl(server(), util.get(qi, "image"), 80)
        n.HDPosterUrl = art
        if i = nowIndex
            n.ShortDescriptionLine1 = "NOW"
            focusIdx = root.getChildCount()
        else
            n.ShortDescriptionLine1 = (i + 1).ToStr()
        end if
        n.ShortDescriptionLine2 = util.formatDuration(util.get(qi, "duration", 0))
        lead = ""
        if i = nowIndex then lead = "now playing"
        speech.describeRow(n, util.get(qi, "duration"), lead)
        n.AddFields({ item: { queue_item_id: qi.queue_item_id, index: i, media_item: mi } })
        root.appendChild(n)
        i = i + 1
    end for
    m.list.content = root
    m.list.jumpToItem = focusIdx
    speakList(m.list, true)
    m.empty.visible = root.getChildCount() = 0
    total = util.get(m.global.queueState, "items")
    if util.isNumber(total) then m.count.text = util.counted(total, "item")
    log.debug("queue", "rows", { shown: root.getChildCount(), from: m.windowStart })
end sub

function entryAt(idx as integer) as dynamic
    if m.list.content = invalid then return invalid
    n = m.list.content.getChild(idx)
    if n = invalid then return invalid
    return n.item
end function

sub onFocused()
    e = entryAt(m.list.itemFocused)
    if e <> invalid then m.top.focusedItem = e.media_item
end sub

' OK opens the row's options ("Play now" first).
sub onSelected()
    e = entryAt(m.list.itemSelected)
    if e = invalid then return
    showQueueOptions(e)
end sub

sub showQueueOptions(e as object)
    m.optEntry = e
    title = util.str(util.getPath(e, "media_item.name"), "Queue item")
    ids = ["playnow"]
    labels = ["Play now"]
    ' MA doesn't move or remove what the player already has (the playing
    ' track and the next one once handed over): it ignores a removal and
    ' refuses a move, so those rows don't offer them.
    if e.index > ma.committedQueueIndex(m.global.queueState)
        ids.Append(["playnext", "remove"])
        labels.Append(["Play next", "Remove from queue"])
    end if
    mi = util.get(e, "media_item")
    if util.isAA(mi) then addViewOptions(mi, ids, labels)
    ids.Push("clear")
    labels.Push("Clear queue")
    m.queueOptIds = ids
    showMenu(title, labels, onQueueOption)
end sub

sub onQueueOption(choice as integer)
    e = m.optEntry
    id = m.queueOptIds[choice]
    log.debug("queue", "option " + id)
    if id = "playnow"
        actions.playQueueItem(e.queue_item_id, e.media_item)
    else if id = "playnext"
        editQueue("player_queues/move_item", { queue_item_id: e.queue_item_id, pos_shift: 0 }, "Playing next")
    else if id = "remove"
        editQueue("player_queues/delete_item", { item_id_or_index: e.queue_item_id }, "Removed")
    else if id = "clear"
        ' As MA's web UI does: the queue empties and playback stops.
        editQueue("player_queues/clear", {}, "Queue cleared")
    else if id = "artist" or id = "album"
        viewOption(e.media_item, id)
    end if
end sub

' A change to the queue's items: the list is read again once MA has made
' it (the poll's item count doesn't show a move), and the queue polled.
sub editQueue(command as string, extra as object, done as string)
    qid = actions.playerQueueId()
    if qid = "" then return
    args = { queue_id: qid }
    args.Append(extra)
    log.info("queue", command, args)
    apic.call(command, args, onQueueEdited, { done: done })
end sub

sub onQueueEdited(resp as object, ctx as object)
    if not resp.ok
        actions.toast("Couldn't change the queue.")
        return
    end if
    actions.toast(ctx.done)
    m.global.pollKick = true
    refresh()
end sub
