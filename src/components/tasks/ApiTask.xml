<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP transport for Music Assistant's POST /api (and GET /info).
     Requests: set `request` to { id, command, args } plus optional
     { method, path, server, token, timeoutMs }. Results arrive on `response`
     as { id, ok, kind, status, data, error, ms, command }. -->
<component name="ApiTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" alwaysNotify="true" />
        <field id="response" type="assocarray" alwaysNotify="true" />
        <!-- true once the task observes `request`; earlier requests would be
             lost, so ApiClient buffers until then. -->
        <field id="ready" type="boolean" value="false" />
    </interface>
</component>
