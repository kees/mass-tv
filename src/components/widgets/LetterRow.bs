import "pkg:/source/lib/Util.bs"
import "pkg:/source/lib/Log.bs"
import "pkg:/source/lib/FocusRing.bs"
import "pkg:/source/lib/Speech.bs"
import "pkg:/source/lib/Letters.bs"

' Each letter is centered in a cell this wide; "All" takes its own width,
' then a gap.
const CELL = 60
const ALL_GAP = 24

sub init()
    m.items = m.top.findNode("items")
    m.ring = m.top.findNode("ring")
    m.labels = letters.labels()
    m.index = 0
    m.boxes = []
    m.spoken = ""
    x = 0
    for i = 0 to m.labels.Count() - 1
        lbl = CreateObject("roSGNode", "Label")
        lbl.font = "font:SmallBoldSystemFont"
        lbl.text = m.labels[i]
        m.items.appendChild(lbl)
        size = focusring.textSize(lbl)
        if i = 0
            lx = 0
            x = size.w + ALL_GAP
        else
            lx = x + (CELL - size.w) / 2
            x = x + CELL
        end if
        lbl.translation = [lx, 0]
        m.boxes.Push({ x: lx, w: size.w, h: size.h })
    end for
    m.top.ObserveField("focusedChild", "onFocusChange")
    ' The row speaks for itself (say): Roku would read every letter.
    m.top.muteAudioGuide = true
    render()
end sub

sub onFocusChange()
    focused = m.top.hasFocus()
    if focused and m.wasFocused <> true then m.spoken = ""
    m.wasFocused = focused
    if focused then logFocus()
    render()
end sub

' Starts the cursor on the letter nearest x, or on the chosen one (-1).
sub onAimX()
    x = m.top.aimX
    if x >= 0
        tx = m.top.translation[0]
        best = 0
        for i = 0 to m.boxes.Count() - 1
            if Abs(center(i) + tx - x) < Abs(center(best) + tx - x) then best = i
        end for
        m.index = best
    else
        m.index = indexOf(m.top.chosen)
    end if
    render()
end sub

function indexOf(label as string) as integer
    for i = 0 to m.labels.Count() - 1
        if m.labels[i] = label then return i
    end for
    return 0
end function

function center(i as integer) as float
    b = m.boxes[i]
    return b.x + b.w / 2
end function

' Logs the cursor's letter and says it: "Letters, D, 6 of 28, shown" as
' the row gets focus, then "E, 7 of 28" as the cursor moves.
sub logFocus()
    label = m.labels[m.index]
    log.debug("letters", "focus", { letter: label })
    parts = []
    if m.spoken = "" then parts.Push(m.top.context)
    if label = letters.OTHER then parts.Push("Digits and symbols") else parts.Push(label)
    parts.Push(speech.position(m.index, m.labels.Count()))
    if label = m.top.chosen then parts.Push("shown")
    text = speech.join(parts)
    speech.say(text)
    m.spoken = text
end sub

' The chosen letter is blue (selected), even under the cursor; while the
' row has focus, the cursor letter is inside the focus ring, in white
' unless it's the chosen one.
sub render()
    focused = m.top.hasFocus()
    for i = 0 to m.items.getChildCount() - 1
        lbl = m.items.getChild(i)
        cursor = i = m.index and focused
        chosen = m.labels[i] = m.top.chosen
        if chosen and cursor
            lbl.color = focusring.SELECTED_TEXT
        else if chosen
            lbl.color = focusring.SELECTED
        else if cursor
            lbl.color = focusring.TEXT
        else
            lbl.color = focusring.PLAIN_TEXT
        end if
    end for
    m.top.cursorX = center(m.index) + m.top.translation[0]
    if focused
        b = m.boxes[m.index]
        focusring.around(m.ring, b.x, 0, b.w, b.h)
    else
        m.ring.visible = false
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    n = m.labels.Count()
    if key = "left"
        if m.index > 0 then m.index = m.index - 1 else m.index = n - 1
    else if key = "right"
        if m.index < n - 1 then m.index = m.index + 1 else m.index = 0
    else if key = "OK"
        log.debug("letters", "pick", { letter: m.labels[m.index] })
        m.top.selected = m.labels[m.index]
        return true
    else
        return false
    end if
    logFocus()
    render()
    return true
end function
