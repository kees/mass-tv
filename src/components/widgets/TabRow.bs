import "pkg:/source/lib/Util.bs"
import "pkg:/source/lib/Log.bs"
import "pkg:/source/lib/FocusRing.bs"
import "pkg:/source/lib/Speech.bs"
import "pkg:/source/lib/Focus.bs"

const TAB_SPACING = 56

sub init()
    m.ring = m.top.findNode("ring")
    m.labels = m.top.findNode("labels")
    m.boxes = []
    m.cursor = 0
    m.hadFocus = false
    m.aimed = false
    ' Spoken from its `cursor` (MainScene's focus tracker): "Profile, tab
    ' 1 of 2, shown".
    m.top.muteAudioGuide = true
    m.top.ObserveField("focusedChild", "onFocusChange")
end sub

sub rebuild()
    m.labels.removeChildrenIndex(m.labels.getChildCount(), 0)
    m.boxes = []
    x = 0
    for each t in m.top.tabs
        lbl = CreateObject("roSGNode", "Label")
        lbl.text = t
        lbl.font = "font:MediumBoldSystemFont"
        lbl.translation = [x, 0]
        m.labels.appendChild(lbl)
        size = focusring.textSize(lbl)
        m.boxes.Push({ x: x, w: size.w, h: size.h })
        x = x + size.w + TAB_SPACING
    end for
    render()
end sub

' Focus arriving puts the cursor on the shown tab, unless it arrived
' aimed (aimAt, whichever of the two is handled first).
sub onFocusChange()
    focused = m.top.hasFocus()
    if focused and not m.hadFocus and not m.aimed then m.cursor = m.top.shown
    if not focused then m.aimed = false
    m.hadFocus = focused
    render()
end sub

sub onAimAt()
    x = m.top.aimAt
    best = -1
    for i = 0 to m.boxes.Count() - 1
        b = m.boxes[i]
        if best < 0 or Abs(b.x + b.w / 2 - x) < Abs(m.boxes[best].x + m.boxes[best].w / 2 - x) then best = i
    end for
    if best < 0 then return
    m.cursor = best
    m.aimed = true
    render()
end sub

sub render()
    focused = m.top.hasFocus()
    for i = 0 to m.labels.getChildCount() - 1
        lbl = m.labels.getChild(i)
        cursor = focused and i = m.cursor
        ' The shown tab stays blue, a stronger blue under the cursor.
        if i = m.top.shown and cursor
            lbl.color = focusring.SELECTED_TEXT
        else if i = m.top.shown
            lbl.color = focusring.SELECTED
        else if cursor
            lbl.color = focusring.TEXT
        else
            lbl.color = focusring.PLAIN_TEXT
        end if
    end for
    if m.cursor < m.boxes.Count()
        b = m.boxes[m.cursor]
        m.top.cursorX = b.x + b.w / 2
    else
        m.top.cursorX = -1
    end if
    if focused and m.cursor < m.boxes.Count()
        b = m.boxes[m.cursor]
        focusring.around(m.ring, b.x, 0, b.w, b.h)
    else
        m.ring.visible = false
    end if
    focusring.logShown("tabs", m.ring.visible)
    describeCursor()
end sub

' The cursor's tab, for the focus tracker; becoming the shown one keeps
' its place, so "shown" is said without counting as a move.
sub describeCursor()
    tabs = m.top.tabs
    if not util.isArray(tabs) or m.cursor >= tabs.Count()
        m.top.cursor = focustrack.describe("tabs", "", "", {})
        return
    end if
    parts = [tabs[m.cursor], "tab " + speech.position(m.cursor, tabs.Count())]
    if m.cursor = m.top.shown then parts.Push("shown")
    m.top.cursor = focustrack.describe("tabs", m.cursor.ToStr(), speech.join(parts), { index: m.cursor, label: tabs[m.cursor] })
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    count = m.boxes.Count()
    ' Left/Right wrap around the row's ends, like every row of text.
    if key = "left" and count > 0
        m.cursor = (m.cursor - 1 + count) mod count
        render()
        return true
    else if key = "right" and count > 0
        m.cursor = (m.cursor + 1) mod count
        render()
        return true
    else if key = "OK" and m.cursor < count
        m.top.shown = m.cursor
        m.top.selected = m.cursor
        render()
        return true
    end if
    return false
end function
