import "pkg:/source/lib/Util.bs"

' QR code encoder (ISO/IEC 18004): byte mode, error correction level M,
' versions 1-10, automatic mask selection. Enough for setup URLs of up to
' 213 bytes. Returns a square matrix (array of rows of booleans, true =
' dark) without the quiet zone, or invalid if the text is too long.
namespace qr

    ' forcedMask 0-7 skips mask selection (used to compare with a reference
    ' encoder in tests); -1 picks the lowest-penalty mask.
    function encode(text as string, forcedMask = -1 as integer) as dynamic
        bytes = CreateObject("roByteArray")
        bytes.FromAsciiString(text)
        n = bytes.Count()
        version = 0
        for v = 1 to 10
            info = qr.versionInfo(v)
            ccBits = 8
            if v >= 10 then ccBits = 16
            if 4 + ccBits + 8 * n <= info.dataCw * 8
                version = v
                exit for
            end if
        end for
        if version = 0 then return invalid

        info = qr.versionInfo(version)
        data = qr.dataCodewords(bytes, version, info.dataCw)
        allCw = qr.addEcc(data, info)
        size = version * 4 + 17

        mods = qr.grid(size, false)
        fn = qr.grid(size, false)
        qr.drawFunctionPatterns(mods, fn, size, version)
        qr.drawCodewords(mods, fn, size, allCw)

        if forcedMask >= 0
            qr.applyMask(mods, fn, size, forcedMask)
            qr.drawFormatBits(mods, fn, size, forcedMask)
            return mods
        end if
        best = 0
        bestPenalty = -1
        for mask = 0 to 7
            qr.applyMask(mods, fn, size, mask)
            qr.drawFormatBits(mods, fn, size, mask)
            p = qr.penalty(mods, size)
            if bestPenalty < 0 or p < bestPenalty
                bestPenalty = p
                best = mask
            end if
            qr.applyMask(mods, fn, size, mask)
        end for
        qr.applyMask(mods, fn, size, best)
        qr.drawFormatBits(mods, fn, size, best)
        return mods
    end function

    ' EC level M block structure for versions 1-10.
    function versionInfo(v as integer) as object
        ' [ecPerBlock, g1Blocks, g1DataCw, g2Blocks, g2DataCw]
        t = [
            [10, 1, 16, 0, 0], [16, 1, 28, 0, 0], [26, 1, 44, 0, 0], [18, 2, 32, 0, 0],
            [24, 2, 43, 0, 0], [16, 4, 27, 0, 0], [18, 4, 31, 0, 0], [22, 2, 38, 2, 39],
            [22, 3, 36, 2, 37], [26, 4, 43, 1, 44]
        ]
        e = t[v - 1]
        return {
            ecPerBlock: e[0], g1Blocks: e[1], g1Data: e[2], g2Blocks: e[3], g2Data: e[4]
            dataCw: e[1] * e[2] + e[3] * e[4]
        }
    end function

    function alignmentPositions(v as integer) as object
        t = [[], [6, 18], [6, 22], [6, 26], [6, 30], [6, 34], [6, 22, 38], [6, 24, 42], [6, 26, 46], [6, 28, 50]]
        return t[v - 1]
    end function

    function grid(size as integer, value as boolean) as object
        rows = []
        for y = 0 to size - 1
            row = []
            for x = 0 to size - 1
                row.Push(value)
            end for
            rows.Push(row)
        end for
        return rows
    end function

    function xorInt(a as integer, b as integer) as integer
        return (a or b) - (a and b)
    end function

    ' --- data encoding ---

    function dataCodewords(bytes as object, version as integer, dataCw as integer) as object
        bits = []
        qr.appendBits(bits, 4, 4)
        ccBits = 8
        if version >= 10 then ccBits = 16
        qr.appendBits(bits, bytes.Count(), ccBits)
        for i = 0 to bytes.Count() - 1
            qr.appendBits(bits, bytes[i], 8)
        end for
        capacity = dataCw * 8
        term = capacity - bits.Count()
        if term > 4 then term = 4
        for i = 1 to term
            bits.Push(0)
        end for
        while (bits.Count() mod 8) <> 0
            bits.Push(0)
        end while
        out = []
        for i = 0 to bits.Count() - 1 step 8
            b = 0
            for j = 0 to 7
                b = b * 2 + bits[i + j]
            end for
            out.Push(b)
        end for
        pad = [236, 17]
        k = 0
        while out.Count() < dataCw
            out.Push(pad[k mod 2])
            k = k + 1
        end while
        return out
    end function

    sub appendBits(bits as object, value as integer, count as integer)
        for i = count - 1 to 0 step -1
            bits.Push((value >> i) and 1)
        end for
    end sub

    ' --- Reed-Solomon ---

    function gfMul(x as integer, y as integer) as integer
        z = 0
        for i = 7 to 0 step -1
            z = qr.xorInt((z << 1) and 511, ((z >> 7) and 1) * 285)
            if ((y >> i) and 1) = 1 then z = qr.xorInt(z, x)
        end for
        return z and 255
    end function

    function rsDivisor(degree as integer) as object
        result = []
        for i = 1 to degree
            result.Push(0)
        end for
        result[degree - 1] = 1
        root = 1
        for i = 0 to degree - 1
            for j = 0 to degree - 1
                result[j] = qr.gfMul(result[j], root)
                if j + 1 < degree then result[j] = qr.xorInt(result[j], result[j + 1])
            end for
            root = qr.gfMul(root, 2)
        end for
        return result
    end function

    function rsRemainder(data as object, divisor as object) as object
        result = []
        for each d in divisor
            result.Push(0)
        end for
        for each b in data
            factor = qr.xorInt(b, result.Shift())
            result.Push(0)
            for i = 0 to divisor.Count() - 1
                result[i] = qr.xorInt(result[i], qr.gfMul(divisor[i], factor))
            end for
        end for
        return result
    end function

    function addEcc(data as object, info as object) as object
        divisor = qr.rsDivisor(info.ecPerBlock)
        blocks = []
        cursor = 0
        for g = 1 to 2
            if g = 1
                count = info.g1Blocks
                length = info.g1Data
            else
                count = info.g2Blocks
                length = info.g2Data
            end if
            for b = 1 to count
                chunk = []
                for i = 0 to length - 1
                    chunk.Push(data[cursor + i])
                end for
                cursor = cursor + length
                blocks.Push({ data: chunk, ecc: qr.rsRemainder(chunk, divisor) })
            end for
        end for
        out = []
        maxData = info.g1Data
        if info.g2Data > maxData then maxData = info.g2Data
        for i = 0 to maxData - 1
            for each blk in blocks
                if i < blk.data.Count() then out.Push(blk.data[i])
            end for
        end for
        for i = 0 to info.ecPerBlock - 1
            for each blk in blocks
                out.Push(blk.ecc[i])
            end for
        end for
        return out
    end function

    ' --- matrix drawing ---

    sub setFn(mods as object, fn as object, x as integer, y as integer, dark as boolean)
        mods[y][x] = dark
        fn[y][x] = true
    end sub

    sub drawFunctionPatterns(mods as object, fn as object, size as integer, version as integer)
        for i = 0 to size - 1
            qr.setFn(mods, fn, 6, i, (i mod 2) = 0)
            qr.setFn(mods, fn, i, 6, (i mod 2) = 0)
        end for
        qr.drawFinder(mods, fn, size, 3, 3)
        qr.drawFinder(mods, fn, size, size - 4, 3)
        qr.drawFinder(mods, fn, size, 3, size - 4)
        centers = qr.alignmentPositions(version)
        last = centers.Count() - 1
        for i = 0 to last
            for j = 0 to last
                corner = (i = 0 and j = 0) or (i = 0 and j = last) or (i = last and j = 0)
                if not corner then qr.drawAlignment(mods, fn, centers[i], centers[j])
            end for
        end for
        qr.drawFormatBits(mods, fn, size, 0)
        qr.drawVersion(mods, fn, size, version)
    end sub

    sub drawFinder(mods as object, fn as object, size as integer, cx as integer, cy as integer)
        for dy = -4 to 4
            for dx = -4 to 4
                ax = Abs(dx)
                ay = Abs(dy)
                dist = ax
                if ay > dist then dist = ay
                x = cx + dx
                y = cy + dy
                if x >= 0 and x < size and y >= 0 and y < size
                    qr.setFn(mods, fn, x, y, dist <> 2 and dist <> 4)
                end if
            end for
        end for
    end sub

    sub drawAlignment(mods as object, fn as object, cx as integer, cy as integer)
        for dy = -2 to 2
            for dx = -2 to 2
                ax = Abs(dx)
                ay = Abs(dy)
                dist = ax
                if ay > dist then dist = ay
                qr.setFn(mods, fn, cx + dx, cy + dy, dist <> 1)
            end for
        end for
    end sub

    ' Level M has format bits 00.
    sub drawFormatBits(mods as object, fn as object, size as integer, mask as integer)
        data = mask
        remd = data
        for i = 1 to 10
            remd = qr.xorInt((remd << 1) and 2047, ((remd >> 9) and 1) * 1335)
        end for
        bits = qr.xorInt(((data << 10) or remd) and 32767, 21522)
        for i = 0 to 5
            qr.setFn(mods, fn, 8, i, ((bits >> i) and 1) = 1)
        end for
        qr.setFn(mods, fn, 8, 7, ((bits >> 6) and 1) = 1)
        qr.setFn(mods, fn, 8, 8, ((bits >> 7) and 1) = 1)
        qr.setFn(mods, fn, 7, 8, ((bits >> 8) and 1) = 1)
        for i = 9 to 14
            qr.setFn(mods, fn, 14 - i, 8, ((bits >> i) and 1) = 1)
        end for
        for i = 0 to 7
            qr.setFn(mods, fn, size - 1 - i, 8, ((bits >> i) and 1) = 1)
        end for
        for i = 8 to 14
            qr.setFn(mods, fn, 8, size - 15 + i, ((bits >> i) and 1) = 1)
        end for
        qr.setFn(mods, fn, 8, size - 8, true)
    end sub

    sub drawVersion(mods as object, fn as object, size as integer, version as integer)
        if version < 7 then return
        remd = version
        for i = 1 to 12
            remd = qr.xorInt((remd << 1) and 8191, ((remd >> 11) and 1) * 7973)
        end for
        bits = (version << 12) or remd
        for i = 0 to 17
            bit = ((bits >> i) and 1) = 1
            a = size - 11 + (i mod 3)
            b = i \ 3
            qr.setFn(mods, fn, a, b, bit)
            qr.setFn(mods, fn, b, a, bit)
        end for
    end sub

    sub drawCodewords(mods as object, fn as object, size as integer, cw as object)
        total = cw.Count() * 8
        i = 0
        right = size - 1
        while right >= 1
            if right = 6 then right = 5
            for vert = 0 to size - 1
                for j = 0 to 1
                    x = right - j
                    upward = ((right + 1) and 2) = 0
                    if upward
                        y = size - 1 - vert
                    else
                        y = vert
                    end if
                    if not fn[y][x] and i < total
                        byte = cw[i >> 3]
                        mods[y][x] = ((byte >> (7 - (i and 7))) and 1) = 1
                        i = i + 1
                    end if
                end for
            end for
            right = right - 2
        end while
    end sub

    sub applyMask(mods as object, fn as object, size as integer, mask as integer)
        for y = 0 to size - 1
            for x = 0 to size - 1
                if not fn[y][x]
                    if mask = 0
                        inv = ((x + y) mod 2) = 0
                    else if mask = 1
                        inv = (y mod 2) = 0
                    else if mask = 2
                        inv = (x mod 3) = 0
                    else if mask = 3
                        inv = ((x + y) mod 3) = 0
                    else if mask = 4
                        inv = (((x \ 3) + (y \ 2)) mod 2) = 0
                    else if mask = 5
                        inv = ((x * y) mod 2) + ((x * y) mod 3) = 0
                    else if mask = 6
                        inv = ((((x * y) mod 2) + ((x * y) mod 3)) mod 2) = 0
                    else
                        inv = ((((x + y) mod 2) + ((x * y) mod 3)) mod 2) = 0
                    end if
                    if inv then mods[y][x] = not mods[y][x]
                end if
            end for
        end for
    end sub

    ' --- mask penalty (rules N1-N4) ---

    function penalty(mods as object, size as integer) as integer
        p = 0
        dark = 0
        for y = 0 to size - 1
            p = p + qr.linePenalty(qr.rowOf(mods, y))
        end for
        for x = 0 to size - 1
            p = p + qr.linePenalty(qr.colOf(mods, size, x))
        end for
        for y = 0 to size - 2
            for x = 0 to size - 2
                c = mods[y][x]
                if c = mods[y][x + 1] and c = mods[y + 1][x] and c = mods[y + 1][x + 1] then p = p + 3
            end for
        end for
        for y = 0 to size - 1
            for x = 0 to size - 1
                if mods[y][x] then dark = dark + 1
            end for
        end for
        total = size * size
        k = 0
        diff = Abs(dark * 20 - total * 10)
        while diff > (k + 1) * total
            k = k + 1
        end while
        return p + k * 10
    end function

    function rowOf(mods as object, y as integer) as object
        return mods[y]
    end function

    function colOf(mods as object, size as integer, x as integer) as object
        col = []
        for y = 0 to size - 1
            col.Push(mods[y][x])
        end for
        return col
    end function

    ' N1 (runs of 5+) and N3 (finder-like 1:1:3:1:1 with 4 light modules on
    ' one side, treating the outside as light).
    function linePenalty(line as object) as integer
        p = 0
        n = line.Count()
        runLen = 1
        for i = 1 to n
            if i < n and line[i] = line[i - 1]
                runLen = runLen + 1
            else
                if runLen >= 5 then p = p + 3 + (runLen - 5)
                runLen = 1
            end if
        end for
        pat = [true, false, true, true, true, false, true]
        for i = 0 to n - 7
            match = true
            for j = 0 to 6
                if line[i + j] <> pat[j]
                    match = false
                    exit for
                end if
            end for
            if match
                if qr.lightRun(line, i - 4, i - 1) or qr.lightRun(line, i + 7, i + 10) then p = p + 40
            end if
        end for
        return p
    end function

    function lightRun(line as object, a as integer, b as integer) as boolean
        for i = a to b
            if i >= 0 and i < line.Count()
                if line[i] then return false
            end if
        end for
        return true
    end function

    ' Horizontal runs of dark modules per row: [[y, x, length], ...]. Lets the
    ' UI draw one Rectangle per run instead of one per module.
    function darkRuns(mods as object) as object
        runs = []
        for y = 0 to mods.Count() - 1
            row = mods[y]
            x = 0
            n = row.Count()
            while x < n
                if row[x]
                    start = x
                    while x < n and row[x]
                        x = x + 1
                    end while
                    runs.Push([y, start, x - start])
                else
                    x = x + 1
                end if
            end while
        end for
        return runs
    end function

    ' Vertical runs of two or more dark modules per column: [[x, y,
    ' length], ...]. Drawn along with darkRuns, they put every boundary
    ' between two dark modules inside some rectangle, never on an edge, so
    ' however the renderer rounds edges (an FHD UI scaled to HD rounded one
    ' row short), no light seam can open between dark modules. Single
    ' modules are left out: darkRuns already covers them.
    function darkColumnRuns(mods as object) as object
        runs = []
        n = mods.Count()
        if n = 0 then return runs
        for x = 0 to mods[0].Count() - 1
            y = 0
            while y < n
                if mods[y][x]
                    start = y
                    while y < n and mods[y][x]
                        y = y + 1
                    end while
                    if y - start >= 2 then runs.Push([x, start, y - start])
                else
                    y = y + 1
                end if
            end while
        end for
        return runs
    end function

end namespace
