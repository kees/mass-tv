import "pkg:/source/lib/Util.bs"

' Right-to-left text (Arabic, Hebrew) for Roku's text renderer, which
' draws characters as given, left to right, one glyph each: it neither
' joins Arabic letters nor orders right-to-left text (seen on a Roku, OS
' 15.3). visual() does both before a label gets the text:
' - shaping: each Arabic letter becomes its isolated, final, initial, or
'   medial presentation form (U+FB50-FEFF, in the bundled font) by
'   whether it joins the letters beside it, lam-alef becomes its
'   ligature, and Arabic vowel marks and Hebrew points are dropped (the
'   renderer can't place them; Hebrew letters don't join);
' - ordering: the Unicode bidirectional algorithm for one line, without
'   explicit embeddings: the first strong letter sets the line's
'   direction, right-to-left runs are reversed, numbers and left-to-right
'   words inside them keep their order, and brackets in them are
'   mirrored.
' Display only: the text itself is left as it is.
namespace bidi

    ' The text in display order and shaped; text without right-to-left
    ' characters comes back unchanged.
    function visual(text as string) as string
        if not bidi.hasRtl(text) then return text
        cps = bidi.shape(bidi.codePoints(text))
        cps = bidi.reorder(cps)
        out = []
        for each c in cps
            out.Push(Chr(c))
        end for
        return out.Join("")
    end function

    function hasRtl(text as string) as boolean
        for i = 1 to Len(text)
            c = Asc(Mid(text, i, 1))
            if (c >= &h0590 and c <= &h08FF) or (c >= &hFB1D and c <= &hFDFF) or (c >= &hFE70 and c <= &hFEFE) then return true
        end for
        return false
    end function

    function codePoints(text as string) as object
        out = []
        for i = 1 to Len(text)
            out.Push(Asc(Mid(text, i, 1)))
        end for
        return out
    end function

    ' --- shaping ---

    ' Arabic vowel marks and other combining marks, and Hebrew points and
    ' cantillation: skipped when deciding what joins, and dropped.
    function isMark(c as integer) as boolean
        if c >= &h0591 and c <= &h05C7
            return c <= &h05BD or c = &h05BF or c = &h05C1 or c = &h05C2 or c = &h05C4 or c = &h05C5 or c = &h05C7
        end if
        return (c >= &h0610 and c <= &h061A) or (c >= &h064B and c <= &h065F) or c = &h0670 or (c >= &h06D6 and c <= &h06DC) or (c >= &h06DF and c <= &h06E4) or c = &h06E7 or c = &h06E8 or (c >= &h06EA and c <= &h06ED) or (c >= &h08D3 and c <= &h08FF)
    end function

    ' Letter (decimal, as a string) -> [isolated, final, initial, medial]
    ' forms, 0 where it has none.
    function forms() as object
        if m.bidiForms = invalid
            ' Generated by tools/arabic_forms.py: letter, isolated, final,
            ' initial, medial (0: no such form).
            t = [
                &h0621, &hFE80, &h0000, &h0000, &h0000, &h0622, &hFE81, &hFE82, &h0000, &h0000
                &h0623, &hFE83, &hFE84, &h0000, &h0000, &h0624, &hFE85, &hFE86, &h0000, &h0000
                &h0625, &hFE87, &hFE88, &h0000, &h0000, &h0626, &hFE89, &hFE8A, &hFE8B, &hFE8C
                &h0627, &hFE8D, &hFE8E, &h0000, &h0000, &h0628, &hFE8F, &hFE90, &hFE91, &hFE92
                &h0629, &hFE93, &hFE94, &h0000, &h0000, &h062A, &hFE95, &hFE96, &hFE97, &hFE98
                &h062B, &hFE99, &hFE9A, &hFE9B, &hFE9C, &h062C, &hFE9D, &hFE9E, &hFE9F, &hFEA0
                &h062D, &hFEA1, &hFEA2, &hFEA3, &hFEA4, &h062E, &hFEA5, &hFEA6, &hFEA7, &hFEA8
                &h062F, &hFEA9, &hFEAA, &h0000, &h0000, &h0630, &hFEAB, &hFEAC, &h0000, &h0000
                &h0631, &hFEAD, &hFEAE, &h0000, &h0000, &h0632, &hFEAF, &hFEB0, &h0000, &h0000
                &h0633, &hFEB1, &hFEB2, &hFEB3, &hFEB4, &h0634, &hFEB5, &hFEB6, &hFEB7, &hFEB8
                &h0635, &hFEB9, &hFEBA, &hFEBB, &hFEBC, &h0636, &hFEBD, &hFEBE, &hFEBF, &hFEC0
                &h0637, &hFEC1, &hFEC2, &hFEC3, &hFEC4, &h0638, &hFEC5, &hFEC6, &hFEC7, &hFEC8
                &h0639, &hFEC9, &hFECA, &hFECB, &hFECC, &h063A, &hFECD, &hFECE, &hFECF, &hFED0
                &h0641, &hFED1, &hFED2, &hFED3, &hFED4, &h0642, &hFED5, &hFED6, &hFED7, &hFED8
                &h0643, &hFED9, &hFEDA, &hFEDB, &hFEDC, &h0644, &hFEDD, &hFEDE, &hFEDF, &hFEE0
                &h0645, &hFEE1, &hFEE2, &hFEE3, &hFEE4, &h0646, &hFEE5, &hFEE6, &hFEE7, &hFEE8
                &h0647, &hFEE9, &hFEEA, &hFEEB, &hFEEC, &h0648, &hFEED, &hFEEE, &h0000, &h0000
                &h0649, &hFEEF, &hFEF0, &hFBE8, &hFBE9, &h064A, &hFEF1, &hFEF2, &hFEF3, &hFEF4
                &h0671, &hFB50, &hFB51, &h0000, &h0000, &h0677, &hFBDD, &h0000, &h0000, &h0000
                &h0679, &hFB66, &hFB67, &hFB68, &hFB69, &h067A, &hFB5E, &hFB5F, &hFB60, &hFB61
                &h067B, &hFB52, &hFB53, &hFB54, &hFB55, &h067E, &hFB56, &hFB57, &hFB58, &hFB59
                &h067F, &hFB62, &hFB63, &hFB64, &hFB65, &h0680, &hFB5A, &hFB5B, &hFB5C, &hFB5D
                &h0683, &hFB76, &hFB77, &hFB78, &hFB79, &h0684, &hFB72, &hFB73, &hFB74, &hFB75
                &h0686, &hFB7A, &hFB7B, &hFB7C, &hFB7D, &h0687, &hFB7E, &hFB7F, &hFB80, &hFB81
                &h0688, &hFB88, &hFB89, &h0000, &h0000, &h068C, &hFB84, &hFB85, &h0000, &h0000
                &h068D, &hFB82, &hFB83, &h0000, &h0000, &h068E, &hFB86, &hFB87, &h0000, &h0000
                &h0691, &hFB8C, &hFB8D, &h0000, &h0000, &h0698, &hFB8A, &hFB8B, &h0000, &h0000
                &h06A4, &hFB6A, &hFB6B, &hFB6C, &hFB6D, &h06A6, &hFB6E, &hFB6F, &hFB70, &hFB71
                &h06A9, &hFB8E, &hFB8F, &hFB90, &hFB91, &h06AD, &hFBD3, &hFBD4, &hFBD5, &hFBD6
                &h06AF, &hFB92, &hFB93, &hFB94, &hFB95, &h06B1, &hFB9A, &hFB9B, &hFB9C, &hFB9D
                &h06B3, &hFB96, &hFB97, &hFB98, &hFB99, &h06BA, &hFB9E, &hFB9F, &h0000, &h0000
                &h06BB, &hFBA0, &hFBA1, &hFBA2, &hFBA3, &h06BE, &hFBAA, &hFBAB, &hFBAC, &hFBAD
                &h06C0, &hFBA4, &hFBA5, &h0000, &h0000, &h06C1, &hFBA6, &hFBA7, &hFBA8, &hFBA9
                &h06C5, &hFBE0, &hFBE1, &h0000, &h0000, &h06C6, &hFBD9, &hFBDA, &h0000, &h0000
                &h06C7, &hFBD7, &hFBD8, &h0000, &h0000, &h06C8, &hFBDB, &hFBDC, &h0000, &h0000
                &h06C9, &hFBE2, &hFBE3, &h0000, &h0000, &h06CB, &hFBDE, &hFBDF, &h0000, &h0000
                &h06CC, &hFBFC, &hFBFD, &hFBFE, &hFBFF, &h06D0, &hFBE4, &hFBE5, &hFBE6, &hFBE7
                &h06D2, &hFBAE, &hFBAF, &h0000, &h0000, &h06D3, &hFBB0, &hFBB1, &h0000, &h0000
            ]
            f = {}
            for i = 0 to t.Count() - 1 step 5
                f[t[i].ToStr()] = [t[i + 1], t[i + 2], t[i + 3], t[i + 4]]
            end for
            m.bidiForms = f
        end if
        return m.bidiForms
    end function

    ' Whether a letter joins the one after it (in reading order) and the
    ' one before it. Tatweel and the zero-width joiner join both ways.
    function joinsForward(c as dynamic) as boolean
        if c = invalid then return false
        if c = &h0640 or c = &h200D then return true
        f = bidi.forms()[c.ToStr()]
        return f <> invalid and (f[2] <> 0 or f[3] <> 0)
    end function

    function joinsBackward(c as dynamic) as boolean
        if c = invalid then return false
        if c = &h0640 or c = &h200D then return true
        f = bidi.forms()[c.ToStr()]
        return f <> invalid and f[1] <> 0
    end function

    ' Code points with Arabic letters in their joined forms (still in
    ' reading order), vowel marks dropped.
    function shape(cps as object) as object
        chars = []
        for each c in cps
            if not bidi.isMark(c) then chars.Push(c)
        end for
        out = []
        n = chars.Count()
        i = 0
        while i < n
            c = chars[i]
            prev = invalid
            if i > 0 then prev = chars[i - 1]
            nxt = invalid
            if i + 1 < n then nxt = chars[i + 1]
            joinedBefore = bidi.joinsForward(prev) and bidi.joinsBackward(c)
            lig = 0
            if c = &h0644 and nxt <> invalid then lig = bidi.lamAlef(nxt, joinedBefore)
            if lig <> 0
                out.Push(lig)
                i = i + 2
            else
                f = bidi.forms()[c.ToStr()]
                if f = invalid
                    out.Push(c)
                else
                    joinedAfter = bidi.joinsForward(c) and bidi.joinsBackward(nxt)
                    form = f[0]
                    if joinedBefore and joinedAfter and f[3] <> 0
                        form = f[3]
                    else if joinedBefore and f[1] <> 0
                        form = f[1]
                    else if joinedAfter and f[2] <> 0
                        form = f[2]
                    end if
                    if form = 0 then form = c
                    out.Push(form)
                end if
                i = i + 1
            end if
        end while
        return out
    end function

    ' Lam followed by an alef: their ligature (final when the lam joins
    ' the letter before), else 0.
    function lamAlef(alef as integer, joinedBefore as boolean) as integer
        iso = 0
        if alef = &h0622 then iso = &hFEF5
        if alef = &h0623 then iso = &hFEF7
        if alef = &h0625 then iso = &hFEF9
        if alef = &h0627 then iso = &hFEFB
        if iso = 0 then return 0
        if joinedBefore then return iso + 1
        return iso
    end function

    ' --- ordering ---

    ' A character's bidirectional type, simplified: "L", "R", "AL", "EN",
    ' "AN", "ES", "ET", "CS", "WS", "NSM", or "ON".
    function typeOf(c as integer) as string
        if c < &h80
            if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) then return "L"
            if c >= 48 and c <= 57 then return "EN"
            if c = 43 or c = 45 then return "ES"
            if c = 35 or c = 36 or c = 37 then return "ET"
            if c = 44 or c = 46 or c = 47 or c = 58 then return "CS"
            if c = 32 or c = 9 then return "WS"
            return "ON"
        end if
        if c < &hC0
            if c = &hA0 then return "CS"
            if c = &hAA or c = &hB5 or c = &hBA then return "L"
            if c = &hB2 or c = &hB3 or c = &hB9 then return "EN"
            if (c >= &hA2 and c <= &hA5) or c = &hB0 or c = &hB1 then return "ET"
            return "ON"
        end if
        if c = &hD7 or c = &hF7 then return "ON"
        if c < &h0300 then return "L"
        if c < &h0370 then return "NSM"
        if c < &h0590 then return "L"
        if c < &h0600
            if (c >= &h0591 and c <= &h05BD) or c = &h05BF or c = &h05C1 or c = &h05C2 or c = &h05C4 or c = &h05C5 or c = &h05C7 then return "NSM"
            return "R"
        end if
        if c < &h0900
            if c <= &h0605 or (c >= &h0660 and c <= &h0669) or c = &h066B or c = &h066C then return "AN"
            if c >= &h06F0 and c <= &h06F9 then return "EN"
            if c = &h060C then return "CS"
            if c = &h066A then return "ET"
            if bidi.isMark(c) then return "NSM"
            return "AL"
        end if
        if c >= &h2000 and c <= &h200A then return "WS"
        if c = &h2028 or c = &h3000 then return "WS"
        if c = &h200E then return "L"
        if c = &h200F then return "R"
        if (c >= &h2070 and c <= &h2079) or (c >= &h2080 and c <= &h2089) or (c >= &hFF10 and c <= &hFF19) then return "EN"
        if (c >= &h2030 and c <= &h2034) or (c >= &h20A0 and c <= &h20CF) then return "ET"
        if c >= &h2000 and c < &h2C00 then return "ON"
        if c >= &hFB1D and c <= &hFB4F then return "R"
        if c >= &hFB50 and c <= &hFDFF then return "AL"
        if c >= &hFE70 and c <= &hFEFE then return "AL"
        if c >= &h1F000 then return "ON"
        return "L"
    end function

    ' Code points in display order (left to right on the screen).
    function reorder(cps as object) as object
        n = cps.Count()
        if n = 0 then return cps
        t = []
        for each c in cps
            t.Push(bidi.typeOf(c))
        end for
        ' The line's direction: its first strong letter's (P2, P3).
        para = 0
        for each x in t
            if x = "L" then exit for
            if x = "R" or x = "AL"
                para = 1
                exit for
            end if
        end for
        sos = "L"
        if para = 1 then sos = "R"
        ' W1: a mark takes the type before it.
        last = sos
        for i = 0 to n - 1
            if t[i] = "NSM" then t[i] = last else last = t[i]
        end for
        ' W2, W3: European digits after Arabic letters are Arabic numbers;
        ' Arabic letters are then right-to-left.
        strong = sos
        for i = 0 to n - 1
            x = t[i]
            if x = "L" or x = "R" or x = "AL"
                strong = x
            else if x = "EN" and strong = "AL"
                t[i] = "AN"
            end if
        end for
        for i = 0 to n - 1
            if t[i] = "AL" then t[i] = "R"
        end for
        ' W4: one separator between two numbers of a kind joins them.
        for i = 1 to n - 2
            if t[i] = "ES" and t[i - 1] = "EN" and t[i + 1] = "EN" then t[i] = "EN"
            if t[i] = "CS" and t[i - 1] = t[i + 1] and (t[i - 1] = "EN" or t[i - 1] = "AN") then t[i] = t[i - 1]
        end for
        ' W5: terminators (currency, %) next to European digits.
        for i = 0 to n - 1
            if t[i] = "ET"
                j = i
                while j < n and t[j] = "ET"
                    j = j + 1
                end while
                if (i > 0 and t[i - 1] = "EN") or (j < n and t[j] = "EN")
                    for k = i to j - 1
                        t[k] = "EN"
                    end for
                end if
            end if
        end for
        ' W6: other separators and terminators are neutral.
        for i = 0 to n - 1
            if t[i] = "ES" or t[i] = "ET" or t[i] = "CS" then t[i] = "ON"
        end for
        ' W7: European digits after left-to-right letters are left to right.
        strong = sos
        for i = 0 to n - 1
            x = t[i]
            if x = "L" or x = "R"
                strong = x
            else if x = "EN" and strong = "L"
                t[i] = "L"
            end if
        end for
        ' N1, N2: a run of neutrals between two of the same direction
        ' (numbers count as right-to-left) takes it, else the line's.
        i = 0
        while i < n
            if t[i] = "ON" or t[i] = "WS"
                j = i
                while j < n and (t[j] = "ON" or t[j] = "WS")
                    j = j + 1
                end while
                before = sos
                if i > 0 then before = bidi.strongDir(t[i - 1])
                after = sos
                if j < n then after = bidi.strongDir(t[j])
                dir = sos
                if before = after then dir = before
                for k = i to j - 1
                    t[k] = dir
                end for
                i = j
            else
                i = i + 1
            end if
        end while
        ' I1, I2: embedding levels.
        levels = []
        for i = 0 to n - 1
            x = t[i]
            lvl = para
            if para = 0
                if x = "R" then lvl = 1
                if x = "EN" or x = "AN" then lvl = 2
            else
                if x = "L" or x = "EN" or x = "AN" then lvl = 2
            end if
            levels.Push(lvl)
        end for
        ' L1: trailing whitespace goes back to the line's level.
        k = n - 1
        while k >= 0 and bidi.typeOf(cps[k]) = "WS"
            levels[k] = para
            k = k - 1
        end while
        ' L2: reverse runs from the highest level down to the lowest odd.
        out = []
        out.Append(cps)
        maxLvl = 0
        minOdd = 99
        for each lvl in levels
            if lvl > maxLvl then maxLvl = lvl
            if lvl mod 2 = 1 and lvl < minOdd then minOdd = lvl
        end for
        if minOdd = 99 then return out
        lv = []
        lv.Append(levels)
        for lvl = maxLvl to minOdd step -1
            i = 0
            while i < n
                if lv[i] >= lvl
                    j = i
                    while j < n and lv[j] >= lvl
                        j = j + 1
                    end while
                    bidi.reverseRange(out, i, j - 1)
                    bidi.reverseRange(lv, i, j - 1)
                    i = j
                else
                    i = i + 1
                end if
            end while
        end for
        ' L4: brackets on right-to-left levels are mirrored. (Levels were
        ' reversed with the characters, so they still line up.)
        for i = 0 to n - 1
            if lv[i] mod 2 = 1 then out[i] = bidi.mirror(out[i])
        end for
        return out
    end function

    ' A resolved type's direction for neutral resolution: numbers count
    ' as right-to-left.
    function strongDir(x as string) as string
        if x = "L" then return "L"
        return "R"
    end function

    sub reverseRange(a as object, i as integer, j as integer)
        while i < j
            tmp = a[i]
            a[i] = a[j]
            a[j] = tmp
            i = i + 1
            j = j - 1
        end while
    end sub

    function mirror(c as integer) as integer
        pairs = [40, 41, 60, 62, 91, 93, 123, 125, &hAB, &hBB, &h2039, &h203A]
        for i = 0 to pairs.Count() - 1 step 2
            if c = pairs[i] then return pairs[i + 1]
            if c = pairs[i + 1] then return pairs[i]
        end for
        return c
    end function
end namespace
