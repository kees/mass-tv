import "pkg:/source/lib/Util.bs"
import "pkg:/source/lib/Log.bs"
import "pkg:/source/lib/MaApi.bs"
import "pkg:/source/lib/ApiClient.bs"
import "pkg:/source/lib/Images.bs"

' Render-thread playback and library actions shared by screens.
namespace actions

    ' MA answers a play request only once it has gathered the tracks (an
    ' artist's whole catalog from a service, by MA's default) and started
    ' the player (for a Roku, over ECP): more than 10 s has been seen.
    const PLAY_TIMEOUT_MS = 60000

    function playerQueueId() as string
        s = m.global.session
        pid = util.str(util.get(s, "playerId"), "")
        if pid = ""
            np = m.global.nowPlaying
            pid = util.str(util.get(np, "queueId"), "")
        end if
        return pid
    end function

    function schema() as integer
        return util.toInt(util.get(m.global.session, "schema"), 0)
    end function

    ' option: "replace" (default), "play", "next", "add". sortBy: see
    ' ma.playMediaArgs.
    ' shown: the item to name in the Now Playing bar while MA starts it
    ' (e.g. the track picked on a playlist page); defaults to item.
    sub play(item as dynamic, option = "replace" as string, startItem = "" as string, shuffle = false as boolean, sortBy = "" as string, shown = invalid as dynamic)
        media = item
        if util.isAA(item) then media = ma.uriOf(item)
        if not util.isNonEmptyString(media)
            actions.toast("That item can't be played.")
            return
        end if
        qid = actions.playerQueueId()
        if qid = ""
            ' MA may list this TV by now (its Roku provider can lose and find
            ' it while running): look again, and send the play if it does
            ' (MainScene's onPlayers). Keys are lowercase: a node field keeps
            ' them that way.
            log.info("actions", "play without player id: looking for the player", { media: media })
            m.global.playAwaitingPlayer = { item: item, option: option, start: startItem, shuffle: shuffle, sort: sortBy, shown: shown }
            m.global.playerCheck = "play"
            return
        end if
        args = ma.playMediaArgs(qid, media, option, startItem, shuffle, actions.schema(), sortBy)
        log.info("actions", "play_media", args)
        if option = "replace" or option = "play"
            if not util.isAA(shown) then shown = item
            m.global.playPending = actions.pendingInfo(shown)
        end if
        apic.call("player_queues/play_media", args, actions.onResult, { what: "play" }, { timeoutMs: actions.PLAY_TIMEOUT_MS })
        if option = "next" then actions.toast("Playing next")
        if option = "add" then actions.toast("Added to queue")
    end sub

    ' Plays an item already in MA's queue (Queue's Play now): like play,
    ' the Now Playing bar shows it loading until the stream starts.
    ' shown: the queue item's track.
    sub playQueueItem(queueItemId as string, shown as dynamic)
        actions.startPlayback("player_queues/play_index", { index: queueItemId }, shown)
    end sub

    ' Starts MA's queue where it is (Play/Pause with nothing loaded): the
    ' bar shows its current item loading. After the queue ended, the
    ' track that ended plays again, by its queue item id, which works even
    ' when MA's queue has lost its current item.
    sub startQueue()
        id = actions.endedItemId()
        if id <> ""
            actions.playQueueItem(id, util.get(ma.queueItemById(m.global.queueState, id), "media_item"))
            return
        end if
        actions.startPlayback("player_queues/play", {}, util.getPath(m.global.queueState, "current_item.media_item"))
    end sub

    ' The queue item id of the track that ended the queue (the player's
    ' "ended": its last track finished with nothing enqueued), else "".
    function endedItemId() as string
        np = m.global.nowPlaying
        if util.get(np, "ended") <> true then return ""
        return util.str(util.get(np, "queueItemId"), "")
    end function

    ' Prev (delta -1) or Next (1) after the queue ended: the queue item
    ' before or after the one that ended, by the queue position MA gave it
    ' while it was current. False when that position isn't known or there's
    ' no item there, for MA's own previous or next.
    function stepEnded(delta as integer) as boolean
        id = actions.endedItemId()
        if id = "" then return false
        q = m.global.queueState
        idx = util.get(ma.queueItemById(q, id), "index")
        if not util.isNumber(idx) then return false
        target = idx + delta
        count = util.get(q, "items")
        if target < 0 or (util.isNumber(count) and target >= count) then return false
        ' The track at that position, when a poll listed it.
        shown = invalid
        recent = util.get(q, "recent_items")
        if util.isArray(recent)
            for each qi in recent
                at = util.get(qi, "index")
                if util.isNumber(at) and at = target then shown = util.get(qi, "media_item")
            end for
        end if
        log.info("actions", "queue ended: play_index", { from: idx, index: target })
        actions.startPlayback("player_queues/play_index", { index: target }, shown)
        return true
    end function

    ' A queue command that starts playback, with play's "Loading…" in the
    ' Now Playing bar and its wait from MA's answer.
    sub startPlayback(command as string, extra as object, shown as dynamic)
        qid = actions.playerQueueId()
        if qid = "" then return
        if util.str(util.get(m.global.session, "token"), "") = "" then return
        args = { queue_id: qid }
        args.Append(extra)
        log.info("actions", command, args)
        m.global.playPending = actions.pendingInfo(shown)
        apic.call(command, args, actions.onResult, { what: "play", command: command }, { timeoutMs: actions.PLAY_TIMEOUT_MS })
    end sub

    ' What the Now Playing bar shows while a play request waits for MA. The
    ' cover URL is the one track rows use (80 px), so it's usually in
    ' Roku's texture cache already and shows at once.
    function pendingInfo(shown as dynamic) as object
        info = { sentAt: util.nowMs(), title: "", artist: "", art: "" }
        if not util.isAA(shown) then return info
        ' The same two lines as the item's row, and as the bar once playing.
        info.title = ma.titleOf(shown)
        info.artist = ma.subtitleOf(shown)
        info.art = images.urlFor(util.str(util.get(m.global.session, "server"), ""), shown, 80)
        return info
    end function

    sub startRadio(item as dynamic)
        uri = ma.radioUri(item)
        if uri = ""
            actions.toast("Can't start an endless mix from this.")
            return
        end if
        actions.play(uri, "replace", "", false, "", item)
        actions.toast("Starting endless mix")
    end sub

    sub queueCommand(command as string, extra = invalid as dynamic)
        qid = actions.playerQueueId()
        if qid = "" then return
        ' Signed out there's no server to ask (the player plays MA's queued
        ' next track by itself when a track ends).
        if util.str(util.get(m.global.session, "token"), "") = ""
            log.debug("actions", command + " skipped: signed out")
            return
        end if
        args = { queue_id: qid }
        if util.isAA(extra)
            for each k in extra
                args[k] = extra[k]
            end for
        end if
        log.info("actions", command, args)
        apic.call(command, args, actions.onResult, { what: command })
    end sub

    sub favorite(item as dynamic, makeFavorite as boolean)
        log.info("actions", "favorite", { add: makeFavorite, uri: ma.uriOf(item), type: ma.mediaTypeOf(item), name: util.str(util.get(item, "name"), "") })
        if makeFavorite
            apic.call("music/favorites/add_item", { item: ma.uriOf(item) }, actions.onResult, { what: "favorite" })
            actions.toast("Added to favorites")
        else
            ' Removal needs the library id.
            args = { media_type: ma.mediaTypeOf(item), item_id: util.str(item.item_id, ""), provider_instance_id_or_domain: util.str(item.provider, "library") }
            apic.call("music/get_library_item", args, actions.onLibraryItemForUnfavorite, { item: item })
        end if
    end sub

    sub onLibraryItemForUnfavorite(resp as object, ctx as object)
        lib = resp.data
        if not resp.ok or not util.isAA(lib)
            actions.toast("Couldn't update favorites.")
            return
        end if
        log.debug("actions", "unfavorite library item", { uri: util.str(lib.uri, ""), name: util.str(lib.name, "") })
        apic.call("music/favorites/remove_item", { media_type: ma.mediaTypeOf(ctx.item), library_item_id: util.str(lib.item_id, "") }, actions.onResult, { what: "unfavorite" })
        actions.toast("Removed from favorites")
    end sub

    sub onResult(resp as object, ctx as object)
        ' Refresh the queue soon after any command that changes it.
        m.global.pollKick = true
        if resp.ok
            ' MA has taken the play request: the stream should follow soon
            ' (the playing bar waits from here, not from the request).
            p = m.global.playPending
            if ctx.what = "play" and util.isAA(p) and p.sentAt <> invalid
                p.answeredAt = util.nowMs()
                m.global.playPending = p
            end if
            return
        end if
        if ctx.what = "play" then m.global.playPending = {}
        log.warn("actions", ctx.what + " failed", { status: resp.status, kind: resp.kind, error: resp.error })
        if ctx.what = "play" and resp.kind <> "network" and resp.kind <> "timeout"
            ' MA refused it: the player ID may be one MA no longer lists
            m.global.playerCheck = "play failed"
        end if
        command = util.str(resp.command, ctx.what)
        if ctx.what = "play" then command = util.str(ctx.command, "player_queues/play_media")
        msg = ma.errorMessage(resp.kind, command, resp.error)
        if msg <> "" then actions.toast(msg)
    end sub

    sub toast(text as string)
        m.global.toast = text
    end sub

end namespace
