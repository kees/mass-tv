import "pkg:/source/lib/Util.bs"

' Music Assistant API helpers: request bodies, status classification, item
' URIs and display text, play arguments, schema gating, and elapsed time.
' Transport lives in components/tasks/ApiTask.
namespace ma

    ' Schema versions that gate features.
    const SCHEMA_SHUFFLE_ARG = 51
    const SCHEMA_BROWSE_PLAYER_ID = 61
    const SCHEMA_MIN_SUPPORTED = 61

    ' Playlist track order "recently added first", as MA's play_media
    ' sort_by and the web UI name it. Needs an MA with the timestamp_added
    ' sort keys and playlist tracks' date_added (music-assistant/server
    ' PRs #6455 and #6457).
    const SORT_NEWEST = "timestamp_added_desc"

    ' The last queue index the player already has (the playing track and
    ' the next one once handed over), as MA's committed_index works it out
    ' from the polled queue state; -1 when it has none (MA then moves and
    ' removes anything). MA won't move or remove items up to it.
    function committedQueueIndex(q as dynamic) as integer
        buf = util.get(q, "index_in_buffer")
        if not util.isNumber(buf) then return -1
        cur = util.get(q, "current_index")
        if not util.isNumber(cur) or cur < buf then return buf
        return cur
    end function

    ' How many of music/recently_played_items Home's "Recently played" row
    ' shows (and a Detail page looks through for its own item).
    const RECENT_LIMIT = 20

    ' The entry of MA's recently played list (music/recently_played_items)
    ' that is this item, or invalid. The play log is keyed by the identity
    ' that was logged (a library item or a service's), so an entry matches
    ' the item's own uri, or one of its provider mappings; removing it
    ' (music/mark_unplayed) takes the entry, not the item.
    function recentEntryFor(recent as dynamic, item as dynamic) as dynamic
        if not util.isArray(recent) or not util.isAA(item) then return invalid
        mt = ma.mediaTypeOf(item)
        uri = ma.uriOf(item)
        maps = util.get(item, "provider_mappings")
        for each r in recent
            if util.isAA(r) and ma.mediaTypeOf(r) = mt
                id = util.str(r.item_id, "")
                if ma.uriOf(r) = uri then return r
                if util.isArray(maps)
                    for each p in maps
                        if util.isAA(p) and util.str(p.item_id, "") = id and util.str(p.provider_instance, "") = util.str(r.provider, "") then return r
                    end for
                end if
            end if
        end for
        return invalid
    end function

    ' Whether any of these tracks carries a date_added (playlist tracks
    ' from a provider that reports when each was added).
    function hasDateAdded(tracks as dynamic) as boolean
        if not util.isArray(tracks) then return false
        for each t in tracks
            if util.isNonEmptyString(util.get(t, "date_added")) then return true
        end for
        return false
    end function

    ' Tracks ordered by date_added, newest first. The sort is stable, so
    ' tracks added together keep their playlist order (as streaming apps
    ' and MA's play order do); tracks without a date sort last. MA sends
    ' date_added as UTC ISO 8601 text, so the strings compare in time order.
    function sortNewestFirst(tracks as object) as object
        keyed = []
        for each t in tracks
            keyed.Push({ key: util.str(util.get(t, "date_added"), ""), item: t })
        end for
        sorted = ma.mergeByKeyDesc(keyed)
        out = []
        for each k in sorted
            out.Push(k.item)
        end for
        return out
    end function

    ' Stable merge sort of { key, item } entries by key, descending.
    function mergeByKeyDesc(list as object) as object
        n = list.Count()
        if n < 2 then return list
        mid = n \ 2
        left = []
        right = []
        for i = 0 to n - 1
            if i < mid then left.Push(list[i]) else right.Push(list[i])
        end for
        left = ma.mergeByKeyDesc(left)
        right = ma.mergeByKeyDesc(right)
        out = []
        li = 0
        ri = 0
        while li < left.Count() and ri < right.Count()
            ' Take from the right only when strictly newer, so ties keep
            ' their original order.
            if right[ri].key > left[li].key
                out.Push(right[ri])
                ri = ri + 1
            else
                out.Push(left[li])
                li = li + 1
            end if
        end while
        while li < left.Count()
            out.Push(left[li])
            li = li + 1
        end while
        while ri < right.Count()
            out.Push(right[ri])
            ri = ri + 1
        end while
        return out
    end function

    function requestBody(id as string, command as string, args as dynamic) as string
        body = { message_id: id, command: command }
        if args <> invalid then body.args = args else body.args = {}
        return FormatJson(body)
    end function

    ' Maps an HTTP status (or roUrlTransfer failure code) to a result kind.
    function classifyStatus(code as integer) as string
        if code >= 200 and code < 300 then return "ok"
        if code = 401 then return "auth"
        if code = 403 then return "forbidden"
        if code = 400 then return "badrequest"
        if code = 503 then return "setup"
        if code >= 500 then return "server"
        if code = -28 then return "timeout"
        if code < 0 then return "network"
        return "http"
    end function

    ' What a command was trying to do, for error messages ("skip ahead").
    function commandPhrase(command as string) as string
        phrases = {
            "player_queues/play_media": "start playback"
            "player_queues/next": "skip ahead"
            "player_queues/previous": "go back"
            "player_queues/seek": "seek"
            "player_queues/play": "resume playback"
            "player_queues/play_pause": "play or pause"
            "player_queues/stop": "stop playback"
            "player_queues/shuffle": "change shuffle"
            "player_queues/repeat": "change repeat"
            "player_queues/play_index": "play that track"
            "player_queues/move_item": "move that track"
            "player_queues/delete_item": "remove that track"
            "music/favorites/add_item": "add that to favorites"
            "music/favorites/remove_item": "remove that from favorites"
            "music/get_library_item": "update favorites"
        }
        p = phrases[command]
        if p <> invalid then return p
        return "do that"
    end function

    ' A user-facing message for a failed action, or "" when the failure is a
    ' connection problem (reported once by the connection status instead of
    ' per action).
    function errorMessage(kind as string, command as string, errorText as dynamic) as string
        phrase = ma.commandPhrase(command)
        if kind = "network" or kind = "timeout" then return ""
        if kind = "forbidden" then return "Your profile isn't allowed to " + phrase + "."
        if kind = "auth" then return "This profile's link expired. Link it again in Settings."
        if kind = "setup" then return "Music Assistant is still starting up. Try again in a moment."
        detail = util.str(errorText, "").Trim()
        if detail = "Internal server error" then detail = ""
        if Len(detail) > 80 then detail = Left(detail, 77) + "..."
        msg = "Music Assistant couldn't " + phrase + "."
        if detail <> "" then msg = msg + " (" + detail + ")"
        return msg
    end function

    function uriOf(item as dynamic) as string
        if not util.isAA(item) then return ""
        if util.isNonEmptyString(item.uri) then return item.uri
        mt = util.str(item.media_type, "")
        prov = util.str(item.provider, "library")
        id = util.str(item.item_id, "")
        if mt = "" or id = "" then return ""
        return prov + "://" + mt + "/" + id
    end function

    function mediaTypeOf(item as dynamic) as string
        return util.str(util.get(item, "media_type"), "")
    end function

    function isPlayable(item as dynamic) as boolean
        if not util.isAA(item) then return false
        if item.is_playable = false then return false
        mt = ma.mediaTypeOf(item)
        return mt = "track" or mt = "album" or mt = "artist" or mt = "playlist" or mt = "radio" or mt = "podcast" or mt = "podcast_episode" or mt = "audiobook" or mt = "genre"
    end function

    function isFolder(item as dynamic) as boolean
        return ma.mediaTypeOf(item) = "folder"
    end function

    ' "Artist A, Artist B" from an item's artists list.
    ' An item's artists' names, joined. MA's "Various Artists" (its
    ' compilation artist) is left out when anyone else is listed, who says
    ' more; alone, it stays.
    function artistNames(item as dynamic) as string
        artists = util.get(item, "artists")
        if not util.isArray(artists) then return util.str(util.get(item, "artist_str"), "")
        names = []
        various = []
        for each a in artists
            n = util.str(util.get(a, "name"), "")
            if n <> ""
                if ma.isVariousArtists(a) then various.Push(n) else names.Push(n)
            end if
        end for
        if names.Count() = 0 then names = various
        return names.Join(", ")
    end function

    ' MA's compilation artist: named "Various Artists", or with its
    ' MusicBrainz id (external_ids pairs).
    function isVariousArtists(artist as dynamic) as boolean
        if LCase(util.str(util.get(artist, "name"), "")) = "various artists" then return true
        ids = util.get(artist, "external_ids")
        if util.isArray(ids)
            for each pair in ids
                if util.isArray(pair) and pair.Count() = 2 and util.str(pair[1], "") = "89ad4ac3-39f7-470e-963a-56509c546377" then return true
            end for
        end if
        return false
    end function

    function titleOf(item as dynamic) as string
        name = util.str(util.get(item, "name"), "")
        version = util.str(util.get(item, "version"), "")
        if version <> "" then return name + " (" + version + ")"
        return name
    end function

    ' The polled queue's item with this queue_item_id: its current item,
    ' its next item, or one it listed recently (recent_items). The item
    ' playing can be any of them: the poll lags a track change, and MA's
    ' queue has reported no current item for a while after the Roku moved
    ' to the enqueued track. invalid when the id is "" or not known.
    function queueItemById(queue as dynamic, queueItemId as string) as dynamic
        if queueItemId = "" then return invalid
        candidates = [util.get(queue, "current_item"), util.get(queue, "next_item")]
        recent = util.get(queue, "recent_items")
        if util.isArray(recent) then candidates.Append(recent)
        for each qi in candidates
            if util.isAA(qi) and util.str(util.get(qi, "queue_item_id"), "") = queueItemId then return qi
        end for
        return invalid
    end function

    ' Title and second line for what's playing, formatted like track rows
    ' (titleOf, subtitleOf) and ending with the track's year when MA has
    ' one ("Artist · Album · 2010"), from the polled queue's item when it
    ' lists the item playing (queueItemById). Otherwise MA's stream
    ' metadata, which has the name without its version and MA's own
    ' artist string.
    function nowPlayingText(np as dynamic, queue as dynamic) as object
        out = { title: util.str(util.get(np, "title"), ""), line2: util.str(util.get(np, "artist"), "") }
        cur = ma.queueItemById(queue, util.str(util.get(np, "queueItemId"), ""))
        if not util.isAA(cur) then return out
        mi = util.get(cur, "media_item")
        if not util.isAA(mi) then return out
        title = ma.titleOf(mi)
        if title <> "" then out.title = title
        line2 = ma.subtitleOf(mi)
        if line2 <> "" then out.line2 = line2
        year = ma.yearOf(mi)
        if year <> "" and out.line2 <> "" then out.line2 = out.line2 + " · " + year
        if year <> "" and out.line2 = "" then out.line2 = year
        return out
    end function

    ' The playing stream's quality, from MA's stream details (the source's
    ' audio_format: content_type, bit_depth, sample_rate, bit_rate) and the
    ' format the Roku receives (the stream URL's): "FLAC · 16-bit · 44.1
    ' kHz", "MP3 · 320 kbps · 44.1 kHz → FLAC". Bit depth for lossless
    ' sources, the bit rate for lossy ones; a content type not known here
    ' shows as MA names it. "" without stream details.
    function streamQualityText(audioFormat as dynamic, sentAs = "" as string) as string
        if not util.isAA(audioFormat) then return ""
        ct = LCase(util.str(util.get(audioFormat, "content_type"), ""))
        if ct = "" or ct = "unknown" then return ""
        name = UCase(ct)
        lossless = ct = "flac" or ct = "alac" or ct = "wav" or ct = "aiff" or ct = "wv" or ct = "ape" or ct = "dsf" or ct = "dff" or Left(ct, 4) = "pcm_"
        if Left(ct, 4) = "pcm_" then name = "PCM"
        parts = [name]
        depth = util.get(audioFormat, "bit_depth")
        kbps = util.get(audioFormat, "bit_rate")
        if lossless and util.isNumber(depth) and depth > 0
            parts.Push(util.numToStr(depth) + "-bit")
        else if not lossless and util.isNumber(kbps) and kbps > 0
            parts.Push(util.numToStr(kbps) + " kbps")
        end if
        rate = util.get(audioFormat, "sample_rate")
        if util.isNumber(rate) and rate > 0
            khz = rate / 1000.0
            if rate mod 1000 = 0
                parts.Push(util.numToStr(Int(khz)) + " kHz")
            else
                parts.Push(Str(Int(khz * 10) / 10.0).Trim() + " kHz")
            end if
        end if
        text = parts.Join(" · ")
        sent = UCase(sentAs)
        if sent <> "" and sent <> name then text = text + " → " + sent
        return text
    end function

    ' An item's year as text, "" when MA has none: its own year (a whole
    ' number, or text as the slim queue item keeps it), else the year of
    ' its release date ("2010-01-01T00:00:00+00:00"), else its album's.
    function yearOf(item as dynamic) as string
        y = util.get(item, "year")
        if util.isNumber(y) and y > 0 then return Int(y).ToStr()
        if util.isString(y) and ma.isYear(y) then return y
        date = util.str(util.getPath(item, "metadata.release_date"), "")
        if ma.isYear(Left(date, 4)) then return Left(date, 4)
        ay = util.getPath(item, "album.year")
        if util.isNumber(ay) and ay > 0 then return Int(ay).ToStr()
        return ""
    end function

    ' Four digits, not 0000.
    function isYear(s as string) as boolean
        if Len(s) <> 4 or s = "0000" then return false
        for i = 1 to 4
            c = Asc(Mid(s, i, 1))
            if c < 48 or c > 57 then return false
        end for
        return true
    end function

    ' Where to read a library artist's whole catalog when MA has no
    ' discography for it: { item_id, provider_instance } of the artist's
    ' first available link to a streaming service the user can see
    ' (visible: instance id -> name, the providers MA lists for this
    ' profile), or invalid. Local-file sources ("filesystem_*") are left
    ' out: their albums are the library's own. Only the user's own
    ' instance: another member's account on the same service would be
    ' read (and played) as that member.
    function discographySource(artist as dynamic, visible as dynamic) as dynamic
        maps = util.get(artist, "provider_mappings")
        if not util.isArray(maps) or not util.isAA(visible) then return invalid
        for each pm in maps
            inst = util.str(util.get(pm, "provider_instance"), "")
            domain = util.str(util.get(pm, "provider_domain"), "")
            id = util.str(util.get(pm, "item_id"), "")
            if inst <> "" and id <> "" and visible.DoesExist(inst) and not util.startsWith(domain, "filesystem") and util.get(pm, "available", true) <> false
                return { item_id: id, provider_instance: inst }
            end if
        end for
        return invalid
    end function

    ' The albums an artist appears on without being their album artist
    ' (compilations): the albums of the artist's library tracks, each once,
    ' in the tracks' order, leaving out the artist's own albums (ownAlbums,
    ' from artist_albums). MA lists only the latter as an artist's albums,
    ' so an artist found only on compilations has none; MA's web UI shows
    ' these as "Appears on".
    function appearsOnAlbums(tracks as dynamic, ownAlbums as dynamic) as object
        out = []
        skip = {}
        if util.isArray(ownAlbums)
            for each a in ownAlbums
                u = ma.uriOf(a)
                if u <> "" then skip[u] = true
            end for
        end if
        if not util.isArray(tracks) then return out
        for each t in tracks
            album = util.get(t, "album")
            u = ma.uriOf(album)
            if u <> "" and not skip.DoesExist(u)
                skip[u] = true
                a = util.copyAA(album)
                if a.media_type = invalid then a.media_type = "album"
                out.Push(a)
            end if
        end for
        return out
    end function

    ' Provider instance id -> name, from MA's providers list.
    function sourceNames(providers as dynamic) as object
        out = {}
        if not util.isArray(providers) then return out
        for each p in providers
            id = util.str(util.get(p, "instance_id"), "")
            name = util.str(util.get(p, "name"), "")
            if id <> "" and name <> "" then out[id] = name
        end for
        return out
    end function

    ' Where an item comes from, for its Detail page: each available
    ' provider mapping's source, named as MA names it for this profile
    ' (names: sourceNames), once each ("<service>", "<service>, Filesystem
    ' (local disk) [music]"). Once names are known, a source that isn't
    ' among them is someone else's (another member's streaming account,
    ' which MA still lists on a shared library item) and is left out;
    ' before they are known, a source shows as MA gives it (its domain).
    ' "" when the item has none.
    function sourceText(item as dynamic, names as dynamic) as string
        parts = []
        seen = {}
        known = util.isAA(names) and names.Count() > 0
        maps = util.get(item, "provider_mappings")
        if util.isArray(maps)
            for each pm in maps
                inst = util.str(util.get(pm, "provider_instance"), "")
                mine = not known or names.DoesExist(inst)
                if util.get(pm, "available", true) <> false and mine
                    name = util.str(util.get(names, inst), "")
                    if name = "" then name = util.str(util.get(pm, "provider_domain"), inst)
                    if name <> "" and not seen.DoesExist(name)
                        seen[name] = true
                        parts.Push(name)
                    end if
                end if
            end for
        end if
        if parts.Count() = 0
            prov = util.str(util.get(item, "provider"), "")
            if prov <> "" and prov <> "library"
                name = util.str(util.get(names, prov), "")
                if name = "" then name = prov
                parts.Push(name)
            end if
        end if
        return parts.Join(", ")
    end function

    ' Second line for cards and rows.
    function subtitleOf(item as dynamic) as string
        mt = ma.mediaTypeOf(item)
        if mt = "track"
            artists = ma.artistNames(item)
            album = util.str(util.getPath(item, "album.name"), "")
            if artists <> "" and album <> "" then return artists + " · " + album
            if artists <> "" then return artists
            return album
        end if
        if mt = "album"
            artists = ma.artistNames(item)
            year = util.get(item, "year")
            if util.isNumber(year) and year > 0
                if artists <> "" then return artists + " · " + year.ToStr()
                return year.ToStr()
            end if
            return artists
        end if
        if mt = "playlist"
            owner = util.str(util.get(item, "owner"), "")
            if owner <> "" then return owner
            return "Playlist"
        end if
        if mt = "artist" then return "Artist"
        if mt = "radio" then return "Radio"
        if mt = "folder" then return ""
        return util.str(util.get(item, "subtitle"), "")
    end function

    ' A card's second line in a row of mixed kinds (Home's "Recently
    ' played"): the kind first, "Album · Josh Woodward · 2010", "Track ·
    ' Josh Woodward · Ashes"; "Artist" and a lone "Playlist" as they are. A
    ' kind without a name here keeps its plain subtitle.
    function kindSubtitleOf(item as dynamic) as string
        names = { album: "Album", track: "Track", playlist: "Playlist", artist: "Artist", podcast: "Podcast", podcast_episode: "Episode", audiobook: "Audiobook", radio: "Radio" }
        subtitle = ma.subtitleOf(item)
        kind = names[ma.mediaTypeOf(item)]
        if kind = invalid then return subtitle
        if subtitle = "" or subtitle = kind then return kind
        return kind + " · " + subtitle
    end function

    ' Whether items (MA media items) are of more than one kind.
    function mixesKinds(items as dynamic) as boolean
        if not util.isArray(items) or items.Count() = 0 then return false
        first = ma.mediaTypeOf(items[0])
        for each it in items
            if ma.mediaTypeOf(it) <> first then return true
        end for
        return false
    end function

    ' Arguments for player_queues/play_media. option: play|replace|next|
    ' replace_next|add, or "" for the server default. sortBy: a track order
    ' MA applies before start_item (e.g. ma.SORT_NEWEST), or "".
    function playMediaArgs(queueId as string, media as dynamic, option as string, startItem as string, shuffle as boolean, schema as integer, sortBy = "" as string) as object
        args = { queue_id: queueId, media: media }
        if option <> "" then args.option = option
        if startItem <> "" then args.start_item = startItem
        if sortBy <> "" then args.sort_by = sortBy
        if shuffle
            if schema >= ma.SCHEMA_SHUFFLE_ARG
                args.shuffle = true
                if option = "" then args.option = "replace"
            end if
        end if
        return args
    end function

    ' URI for "start radio" (MA's endless mix) from a seed item.
    function radioUri(seed as dynamic) as string
        uri = ma.uriOf(seed)
        if uri = "" then return ""
        return "radio_playlist://playlist/" + uri
    end function

    function browseArgs(path as dynamic, playerId as string, schema as integer) as object
        args = {}
        if util.isNonEmptyString(path) then args.path = path
        if playerId <> "" and schema >= ma.SCHEMA_BROWSE_PLAYER_ID then args.player_id = playerId
        return args
    end function

    ' Position of a queue in seconds, from its anchor.
    ' serverNowSec: current server time in seconds (local clock + offset).
    function elapsedOf(queue as dynamic, serverNowSec as double) as double
        if not util.isAA(queue) then return 0
        base = util.get(queue, "elapsed_time", 0)
        if not util.isNumber(base) then base = 0
        state = util.str(util.get(queue, "state"), "")
        if state <> "playing" then return base
        anchor = util.get(queue, "elapsed_time_last_updated", 0)
        speed = util.get(queue, "playback_speed", 1)
        if not util.isNumber(anchor) or anchor <= 0 then return base
        if not util.isNumber(speed) then speed = 1
        delta = serverNowSec - anchor
        if delta < 0 then delta = 0
        return base + delta * speed
    end function

    ' Picks the queue id to target for a player.
    function queueIdForPlayer(player as dynamic) as string
        if not util.isAA(player) then return ""
        src = util.str(util.get(player, "active_source"), "")
        if src <> "" then return src
        return util.str(util.get(player, "player_id"), "")
    end function

    ' Finds this Roku among players/all: a player that reaches a Roku
    ' through the Media Assistant (Roku) provider, matched by IP address,
    ' else by name. Music Assistant can list such a player under another
    ' provider, with the Roku provider among its output protocols.
    function findRokuPlayer(players as dynamic, myIps as object, myName as string) as dynamic
        if not util.isArray(players) then return invalid
        byName = invalid
        for each p in players
            if ma.isRokuPlayer(p)
                ip = ma.playerIp(p)
                for each mine in myIps
                    if ip <> "" and ip = mine then return p
                end for
                if byName = invalid and myName <> "" and util.str(util.get(p, "name"), "") = myName then byName = p
            end if
        end for
        return byName
    end function

    function isRokuPlayer(p as dynamic) as boolean
        if util.startsWith(util.str(util.get(p, "provider"), ""), "roku_media_assistant") then return true
        protocols = util.get(p, "output_protocols")
        if util.isArray(protocols)
            for each proto in protocols
                if util.startsWith(util.str(util.get(proto, "protocol_domain"), ""), "roku_media_assistant") then return true
            end for
        end if
        return false
    end function

    ' A player's IP address: in device_info's identifiers, or device_info
    ' itself.
    function playerIp(p as dynamic) as string
        ip = util.str(util.getPath(p, "device_info.identifiers.ip_address"), "")
        if ip = "" then ip = util.str(util.getPath(p, "device_info.ip_address"), "")
        return ip
    end function

    ' The players as a short list for the log, when this Roku isn't found
    ' among them (what was there, not just that it failed).
    function playerSummary(players as dynamic) as object
        out = []
        if not util.isArray(players) then return out
        for each p in players
            out.Push({ id: util.str(util.get(p, "player_id"), ""), provider: util.str(util.get(p, "provider"), ""), name: util.str(util.get(p, "name"), ""), ip: ma.playerIp(p), roku: ma.isRokuPlayer(p) })
        end for
        return out
    end function

    ' Whether a player ID is among players/all.
    function hasPlayer(players as dynamic, playerId as string) as boolean
        if not util.isArray(players) then return false
        for each p in players
            if util.str(util.get(p, "player_id"), "") = playerId then return true
        end for
        return false
    end function

    ' An item's description as plain text, or "" if it has none:
    ' metadata.description (an artist's biography, an album's summary,
    ' from the music source or a metadata provider such as TheAudioDB),
    ' then for an album its review (metadata.review, a critic's or user's
    ' take) when it has one. paragraphs: a blank line between the two (the
    ' text panel); else a space (a short preview).
    function descriptionOf(item as dynamic, paragraphs = false as boolean) as string
        desc = ma.plainText(util.str(util.getPath(item, "metadata.description"), ""))
        if ma.mediaTypeOf(item) <> "album" then return desc
        review = ma.plainText(util.str(util.getPath(item, "metadata.review"), ""))
        if review = "" or review = desc then return desc
        if desc = "" then return review
        if paragraphs then return desc + Chr(10) + Chr(10) + review
        return desc + " " + review
    end function

    ' MA's web UI renders descriptions as Markdown (and they may carry
    ' HTML); a Label shows plain text. Keeps link text, drops link targets,
    ' tags, and emphasis marks, decodes common entities, and joins lines.
    function plainText(text as string) as string
        s = text
        ' [text](url) -> text, one link at a time: brs-cli's roRegex has
        ' no \1 back-references in ReplaceAll (a real Roku does).
        link = CreateObject("roRegex", "\[([^\]]*)\]\([^)]*\)", "")
        for i = 1 to 100
            found = link.Match(s)
            if found.Count() < 2 then exit for
            s = s.Replace(found[0], found[1])
        end for
        s = CreateObject("roRegex", "<[^>]*>", "").ReplaceAll(s, " ")
        s = CreateObject("roRegex", "(\*\*|__|^#+ )", "m").ReplaceAll(s, "")
        entities = [["&nbsp;", " "], ["&quot;", Chr(34)], ["&#39;", "'"], ["&apos;", "'"], ["&lt;", "<"], ["&gt;", ">"], ["&amp;", "&"]]
        for each e in entities
            s = s.Replace(e[0], e[1])
        end for
        s = CreateObject("roRegex", "\s+", "").ReplaceAll(s, " ")
        ' A tag became a space; don't leave one before punctuation.
        for each p in [".", ",", ";", ":", "!", "?"]
            s = s.Replace(" " + p, p)
        end for
        return s.Trim()
    end function

end namespace
