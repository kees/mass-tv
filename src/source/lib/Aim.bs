import "pkg:/source/lib/Util.bs"
import "pkg:/source/lib/Log.bs"
import "pkg:/source/lib/Focus.bs"

' Where the cursor is on screen, for aiming Up into the nav bar at the
' entry most directly above it (ui-idioms, "Aiming between rows"), worked
' out from the focused widget itself so no screen has to describe its
' layout:
' - MarkupGrid: its focused column, from itemSize, itemSpacing, numColumns;
' - RowList: the focused card's column on screen, which with floating
'   focus depends on how far the row has scrolled; RowList doesn't expose
'   that, so aim.trackRowList follows it (a row scrolls only when the
'   cursor would pass its last or first fully visible card);
' - ButtonRow: its focused button (a real node, measured);
' - TabRow: its cursor's tab (the row reports its center);
' - MarkupList/LabelList and anything else: none (full-width rows have
'   nothing in particular above them).
' List items can't be measured directly: Roku draws them through internal
' nodes outside the scene tree (their sceneBoundingRect is at x 0).
' The same geometry aims the other way (aimInto: Down from the nav bar)
' and between a screen's own widgets (moveFocus).
namespace aim

    ' The cursor's horizontal center on screen under `top` (a screen), or
    ' -1 when there is none worth aiming at.
    function cursorCenterX(top as dynamic) as float
        if top = invalid then return -1
        return aim.widgetCenterX(aim.focusedLeaf(top))
    end function

    ' The horizontal center on screen of a widget's cursor, or -1: a card
    ' row or grid's focused card, a ButtonRow's focused button; full-width
    ' lists and anything else have none.
    function widgetCenterX(leaf as object) as float
        kind = leaf.subtype()
        if kind = "MarkupGrid"
            cols = leaf.numColumns
            if cols < 1 then cols = 1
            col = leaf.itemFocused mod cols
            if col < 0 then return -1
            pitch = leaf.itemSize[0] + leaf.itemSpacing[0]
            return aim.sceneX(leaf) + col * pitch + leaf.itemSize[0] / 2
        else if kind = "RowList"
            return aim.rowListCenterX(leaf)
        else if kind = "ButtonRow"
            b = aim.buttonAt(leaf, leaf.focusIndex)
            if b = invalid then return -1
            return aim.sceneX(b) + b.getChild(0).width / 2
        else if kind = "TabRow"
            if leaf.cursorX < 0 then return -1
            return aim.sceneX(leaf) + leaf.cursorX
        end if
        return -1
    end function

    ' A ButtonRow's button group i (its first child is the button's pill).
    function buttonAt(row as object, i as integer) as dynamic
        buttons = row.findNode("row")
        if buttons = invalid or i < 0 or i >= buttons.getChildCount() then return invalid
        b = buttons.getChild(i)
        if b.getChildCount() = 0 then return invalid
        return b
    end function

    ' Moves the focus from one widget to another (e.g. a Detail page's
    ' buttons and its rows of cards), landing on the item most directly
    ' above or below the cursor that was left.
    sub moveFocus(fromWidget as object, toWidget as object)
        x = aim.widgetCenterX(aim.focusedLeaf(fromWidget))
        ' Aimed before the focus arrives, so it lands once, where aimed
        ' (not first on the widget's old cursor); then again for a widget
        ' inside a group, which only the focus reveals.
        aim.aimInto(toWidget, x)
        focustrack.set(toWidget)
        aim.aimInto(aim.focusedLeaf(toWidget), x)
    end sub

    ' The deepest node in `top`'s focus chain (the widget taking keys).
    function focusedLeaf(top as object) as object
        leaf = top
        for i = 0 to 30
            fc = leaf.focusedChild
            if fc = invalid or fc.isSameNode(leaf) then exit for
            leaf = fc
        end for
        return leaf
    end function

    ' A node's left edge on screen: its translations up to the scene.
    function sceneX(node as object) as float
        x = 0.0
        n = node
        for i = 0 to 40
            if n = invalid then exit for
            if n.hasField("translation") then x = x + n.translation[0]
            n = n.getParent()
        end for
        return x
    end function

    function rowListCenterX(list as object) as float
        rf = list.rowItemFocused
        if not util.isArray(rf) or rf.Count() < 2 then return -1
        row = rf[0]
        col = rf[1]
        size = aim.perRow(list.rowItemSize, row)
        gap = aim.perRow(list.rowItemSpacing, row)
        if size = invalid then return -1
        spacing = 0
        if gap <> invalid then spacing = gap[0]
        first = aim.firstVisible(list, row)
        x = aim.sceneX(list) + (col - first) * (size[0] + spacing) + size[0] / 2
        log.debug("aim", "row list", { row: row, col: col, first: first, left: aim.sceneX(list), x: x })
        return x
    end function

    ' A RowList per-row setting: the row's own entry, else the last one.
    function perRow(values as dynamic, row as integer) as dynamic
        if not util.isArray(values) or values.Count() = 0 then return invalid
        if row < values.Count() then return values[row]
        return values[values.Count() - 1]
    end function

    ' How many cards of a row fit wholly in the list's width.
    function visibleCards(list as object, row as integer) as integer
        size = aim.perRow(list.rowItemSize, row)
        gap = aim.perRow(list.rowItemSpacing, row)
        if size = invalid then return 1
        spacing = 0
        if gap <> invalid then spacing = gap[0]
        n = Int((list.itemSize[0] + spacing) / (size[0] + spacing))
        if n < 1 then n = 1
        return n
    end function

    function firstVisible(list as object, row as integer) as integer
        if not list.hasField("aimFirst") then return 0
        first = util.get(list.aimFirst, row.ToStr())
        if util.isNumber(first) then return first
        return 0
    end function

    ' Follows a RowList's horizontal scrolling: call once per list (from
    ' the component that owns the list's thread, e.g. MainScene).
    sub trackRowList(list as object)
        if list.hasField("aimFirst") then return
        list.AddField("aimFirst", "assocarray", false)
        list.aimFirst = {}
        list.ObserveField("rowItemFocused", "aim_onRowItemFocused")
    end sub

    ' Floating focus: the row scrolls only when the cursor would leave its
    ' fully visible cards, just far enough to keep the cursor in view.
    sub onRowItemFocused(event as object)
        list = event.getRoSGNode()
        rf = event.getData()
        if not util.isArray(rf) or rf.Count() < 2 then return
        row = rf[0]
        col = rf[1]
        ' A loading row reports column -1: not a move.
        if row < 0 or col < 0 then return
        window = list.aimFirst
        first = aim.firstVisible(list, row)
        n = aim.visibleCards(list, row)
        if col < first then first = col
        if col > first + n - 1 then first = col - n + 1
        if first < 0 then first = 0
        window[row.ToStr()] = first
        list.aimFirst = window
        ' Per row, the card that gets the focus if the cursor moves there,
        ' for the cards to show the frame on the right one while a row
        ' change animates (PosterCard): this row's focused card; in the
        ' others, the card in the cursor's slot on screen (RowList keeps
        ' the cursor's horizontal position between rows).
        if list.content = invalid then return
        slot = col - first
        for r = 0 to list.content.getChildCount() - 1
            rowNode = list.content.getChild(r)
            target = col
            if r <> row then target = aim.clamp(aim.firstVisible(list, r) + slot, 0, rowNode.getChildCount() - 1)
            if not rowNode.hasField("focusCol") then rowNode.AddField("focusCol", "integer", false)
            if rowNode.focusCol <> target then rowNode.focusCol = target
        end for
    end sub

    ' Every RowList under `node` (a new screen) gets tracked.
    sub trackRowLists(node as object)
        if node = invalid then return
        if node.subtype() = "RowList" then aim.trackRowList(node)
        for i = 0 to node.getChildCount() - 1
            aim.trackRowLists(node.getChild(i))
        end for
    end sub

    ' Down from the nav bar: moves the focused widget's cursor to the item
    ' most directly below screen x (the nav cursor's center): the card of
    ' a card row or grid under it (keeping the row), or the nearest button
    ' or tab.
    ' Full-width lists keep their cursor.
    sub aimInto(leaf as object, x as float)
        if x < 0 then return
        kind = leaf.subtype()
        if kind = "RowList"
            rf = leaf.rowItemFocused
            if not util.isArray(rf) or rf.Count() < 2 or leaf.content = invalid then return
            row = rf[0]
            if row < 0 then row = 0
            size = aim.perRow(leaf.rowItemSize, row)
            gap = aim.perRow(leaf.rowItemSpacing, row)
            rowNode = leaf.content.getChild(row)
            if size = invalid or rowNode = invalid then return
            spacing = 0
            if gap <> invalid then spacing = gap[0]
            slot = Int((x - aim.sceneX(leaf)) / (size[0] + spacing))
            slot = aim.clamp(slot, 0, aim.visibleCards(leaf, row) - 1)
            col = aim.clamp(aim.firstVisible(leaf, row) + slot, 0, rowNode.getChildCount() - 1)
            log.debug("aim", "down into row list", { x: x, row: row, col: col })
            if col <> rf[1] then leaf.jumpToRowItem = [row, col]
        else if kind = "MarkupGrid"
            if leaf.content = invalid then return
            cols = leaf.numColumns
            if cols < 1 then cols = 1
            col = aim.clamp(Int((x - aim.sceneX(leaf)) / (leaf.itemSize[0] + leaf.itemSpacing[0])), 0, cols - 1)
            cur = leaf.itemFocused
            if cur < 0 then cur = 0
            idx = aim.clamp(Int(cur / cols) * cols + col, 0, leaf.content.getChildCount() - 1)
            log.debug("aim", "down into grid", { x: x, index: idx })
            if idx <> leaf.itemFocused then leaf.jumpToItem = idx
        else if kind = "ButtonRow"
            best = -1
            bestDist = 0
            for i = 0 to 30
                b = aim.buttonAt(leaf, i)
                if b = invalid then exit for
                d = Abs(aim.sceneX(b) + b.getChild(0).width / 2 - x)
                if best < 0 or d < bestDist
                    best = i
                    bestDist = d
                end if
            end for
            log.debug("aim", "down into buttons", { x: x, index: best })
            if best >= 0 and best <> leaf.focusIndex then leaf.focusIndex = best
        else if kind = "TabRow"
            log.debug("aim", "down into tabs", { x: x })
            leaf.aimAt = x - aim.sceneX(leaf)
        end if
    end sub

    ' Down in a grid whose next row is shorter than the cursor's column:
    ' Roku's grid refuses the key; move to that row's last card, the one
    ' closest below. Returns true when it moved.
    function gridDown(leaf as object) as boolean
        if leaf.subtype() <> "MarkupGrid" or leaf.content = invalid then return false
        cols = leaf.numColumns
        if cols < 1 then cols = 1
        cur = leaf.itemFocused
        count = leaf.content.getChildCount()
        nextRow = (Int(cur / cols) + 1) * cols
        if cur < 0 or nextRow >= count then return false
        log.debug("aim", "down into short row", { from: cur, to: count - 1 })
        leaf.jumpToItem = count - 1
        return true
    end function

    function clamp(v as integer, lo as integer, hi as integer) as integer
        if v > hi then v = hi
        if v < lo then v = lo
        return v
    end function

end namespace
