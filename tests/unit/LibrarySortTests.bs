sub librarySortTests()
    tst.begin("librarysort")
    tst.eq(librarysort.fieldsFor("albums"), ["name", "year", "albumArtist", "added", "played", "plays"], "album fields")
    tst.eq(librarysort.fieldsFor("nope"), ["name"], "unknown tab")
    tst.eq(librarysort.orderBy("name", false), "sort_name", "name A-Z")
    tst.eq(librarysort.orderBy("name", true), "sort_name_desc", "name Z-A")
    tst.eq(librarysort.orderBy("added", false), "timestamp_added_desc", "newest first by default")
    tst.eq(librarysort.orderBy("added", true), "timestamp_added", "reversed: oldest first")
    tst.eq(librarysort.orderBy("trackArtist", false), "track_artist_name", "track artist")
    tst.eq(librarysort.orderBy("bogus", true), "sort_name_desc", "unknown field falls back to name")
    tst.eq(librarysort.describe("duration", false), "Length (shortest)", "describe")
    tst.eq(librarysort.describe("added", true), "Date added (oldest)", "describe reversed")
    tst.eq(librarysort.valid("artists", { field: "year", reverse: true }), { field: "name", reverse: false }, "field not on this tab")
    tst.eq(librarysort.valid("albums", { field: "year", reverse: true }), { field: "year", reverse: true }, "stored choice kept")
    tst.eq(librarysort.valid("albums", invalid), { field: "name", reverse: false }, "nothing stored")
end sub
