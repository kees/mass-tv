sub lruTests()
    tst.begin("lru")
    c = lru.new(3)
    lru.set(c, "a", 1)
    lru.set(c, "b", 2)
    lru.set(c, "c", 3)
    tst.eq(lru.count(c), 3, "filled to capacity")
    tst.eq(lru.get(c, "a"), 1, "a found (now the most recent)")
    lru.set(c, "d", 4)
    tst.ok(not lru.has(c, "b"), "the least recently used (b) dropped")
    tst.ok(lru.has(c, "a") and lru.has(c, "c") and lru.has(c, "d"), "the rest kept")
    tst.eq(lru.count(c), 3, "still at capacity")
    lru.set(c, "c", 30)
    tst.eq(lru.get(c, "c"), 30, "a new value for a key")
    tst.eq(lru.count(c), 3, "a replaced key isn't a new entry")
    lru.set(c, "e", 5)
    tst.ok(not lru.has(c, "a"), "a dropped: c and d were used after it")
    tst.eq(lru.get(c, "missing"), invalid, "absent")
    tst.eq(lru.get(c, "C"), 30, "keys ignore case, like associative arrays")
    lru.set(c, "f", "")
    tst.ok(lru.has(c, "f"), "an empty value is an entry")
    tst.eq(lru.get(c, "f"), "", "and comes back as it was")
    ' A long run stays within the capacity.
    big = lru.new(200)
    for i = 1 to 1000
        lru.set(big, "example_music--x://album/" + i.ToStr(), "2009")
    end for
    tst.eq(lru.count(big), 200, "1000 albums, 200 kept")
    tst.ok(lru.has(big, "example_music--x://album/1000") and not lru.has(big, "example_music--x://album/800"), "the newest 200")
end sub
