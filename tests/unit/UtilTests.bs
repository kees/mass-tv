sub utilTests()
    tst.begin("util")
    tst.eq(util.counted(0, "track"), "0 tracks", "zero: plural")
    tst.eq(util.counted(1, "track"), "1 track", "one: singular")
    tst.eq(util.counted(2, "track"), "2 tracks", "two: plural")
    tst.eq(util.counted(1, "day"), "1 day", "one day")
    tst.eq(util.counted(3, "match", "matches"), "3 matches", "an irregular plural")
    tst.eq(util.formatDuration(0), "0:00", "duration 0")
    tst.eq(util.formatDuration(65), "1:05", "duration 65")
    tst.eq(util.formatDuration(3725), "1:02:05", "duration h")
    tst.eq(util.formatDuration(invalid), "0:00", "duration invalid")
    tst.ok(util.isNumber(Box(5)), "boxed int is a number")
    tst.eq(util.numToStr(Box(7)), "7", "boxed int to string")
    tst.ok(util.isNumber(1.5) and not util.isNumber("1"), "isNumber")
    tst.eq(util.toInt("42"), 42, "toInt")
    tst.eq(util.toInt("x", -1), -1, "toInt bad")
    tst.eq(util.toInt("None", invalid), invalid, "toInt None")
    tst.eq(util.toBool("TRUE"), true, "toBool")
    tst.eq(util.toBool("nah", false), false, "toBool fallback")
    tst.eq(util.urlDecode("a%20b%2Fc"), "a b/c", "urlDecode")
    tst.eq(util.urlDecode("caf%C3%A9"), "café", "urlDecode utf8")
    tst.eq(util.urlEncode("a b/é"), "a%20b%2F%C3%A9", "urlEncode")
    q = util.parseQuery("code=abc&return_url=http%3A%2F%2Fx%2Fcb&flag")
    tst.eq(q.code, "abc", "query code")
    tst.eq(q.return_url, "http://x/cb", "query url")
    tst.eq(q.flag, "", "query flag")
    p = util.parseUrl("http://192.168.1.10:8097/single/s/q/i/p.flac?x=1")
    tst.eq(p.host, "192.168.1.10", "url host")
    tst.eq(p.port, 8097, "url port")
    tst.eq(p.path, "/single/s/q/i/p.flac", "url path")
    tst.eq(p.query, "x=1", "url query")
    tst.eq(util.parseUrl("ftp://x"), invalid, "url non-http")
    tst.eq(util.parseUrl("https://ma.example/").port, 443, "https default port")
    tst.eq(util.normalizeServer("192.168.1.10"), "http://192.168.1.10:8095", "normalize bare")
    tst.eq(util.normalizeServer("http://ma.lan:9000/"), "http://ma.lan:9000", "normalize port")
    tst.eq(util.normalizeServer("https://ma.example"), "https://ma.example:443", "normalize https")
    tst.eq(util.normalizeServer("  "), "", "normalize empty")
    tst.eq(util.getPath({ a: { b: { c: 3 } } }, "a.b.c"), 3, "getPath")
    tst.eq(util.getPath({ a: 1 }, "a.b", "d"), "d", "getPath fallback")
    tst.eq(Len(util.randomHex(16)), 16, "randomHex")
    tst.eq(util.htmlEscape("<a href='x'>&</a>"), "&lt;a href=&#39;x&#39;&gt;&amp;&lt;/a&gt;", "htmlEscape")
end sub
